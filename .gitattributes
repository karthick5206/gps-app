# Linux deploy files must keep LF line endings even in a Windows checkout.
*.sh text eol=lf
*.service text eol=lf
ops/deploy/docker/Dockerfile text eol=lf
ops/deploy/docker/Caddyfile text eol=lf
ops/deploy/docker/docker-compose.yml text eol=lf
ops/valkey/** text eol=lf

# Web fonts are binary
*.woff2 binary

# Prisma checksums cover the exact bytes of each migration: keep them LF on every platform (QA B8), so a
# Windows checkout computes the same checksum as the Linux checkout production was migrated from.
apps/api/prisma/migrations/**/migration.sql text eol=lf
apps/api/prisma/migrations/migration_lock.toml text eol=lf
