[Unit]
Description=VeeTrax ETMS routing worker (optimisation jobs; inert unless ETMS_ROUTING=on)
After=network-online.target postgresql.service valkey-server.service veetrax-optimizer.service
Wants=network-online.target

[Service]
User=veetrax
WorkingDirectory=/opt/veetrax/app/apps/api
EnvironmentFile=/opt/veetrax/app/apps/api/.env
# Optimiser token (E4 security review L9): read from the optimiser's own file (root:veetrax 0640, OPTIMIZER_TOKEN=...),
# so it need not be copied into apps/api/.env, which every VeeTrax unit loads. The units that do not call the
# optimiser (gateway, processor, notifier, summarizer) have this path made inaccessible (InaccessiblePaths).
Environment=OPTIMIZER_TOKEN_FILE=/etc/veetrax/optimizer.env
# Exits 0 at once when ETMS_ROUTING is not "on"; Restart=on-failure leaves it stopped then.
ExecStart=/usr/bin/node --max-old-space-size=768 dist/routing-worker/main.js
Restart=on-failure
RestartSec=10
# SIGTERM: stops claiming and waits ROUTING_WORKER_GRACE_MS (30 s) for running jobs; a killed job is re-queued by
# the lease sweeper of the next worker start.
TimeoutStopSec=45
# Shared 6 vCPU / 27 GB host (PostgreSQL 8 GB, GraphHopper, Photon 3 GB, the API stack): the worker mostly waits on
# GraphHopper and the optimiser, so one core and 1 GiB are ample; lower priority than tracking; never swaps.
CPUQuota=100%
MemoryMax=1G
MemorySwapMax=0
Nice=10
# Network: loopback only (PostgreSQL, Valkey, GraphHopper and the optimiser all listen on 127.0.0.1 / ::1). A
# DATABASE_URL / REDIS_URL / ROUTER_URL on another host needs IPAddressAllow= for it (systemctl edit).
IPAddressDeny=any
IPAddressAllow=localhost
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# File system: read-only everywhere (ProtectSystem=strict). The worker writes nothing to disk (logs go to the
# journal), so there are no ReadWritePaths; /tmp is private.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native
# Logs (ids, counts and error codes only, never coordinates): journalctl -u veetrax-routing-worker -f

[Install]
WantedBy=multi-user.target
