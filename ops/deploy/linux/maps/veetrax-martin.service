[Unit]
Description=VeeTrax map tiles (Martin, India + USA vector tiles) on localhost:3000
After=network-online.target
# Built by Planetiler (OpenMapTiles schema) and moved here; see ops/deploy/linux/maps/README.md
ConditionPathExists=/opt/veetrax/maps/india.pmtiles

[Service]
User=veetrax
# Sources "india" (india.pmtiles) and, once the file exists, "us" (us.pmtiles); the styles load the composite source
# /india,us/{z}/{x}/{y}. Without us.pmtiles only india is served, as before (styles built with TILE_SOURCES=india).
# "$$" is a literal "$" for sh (systemd expands a single "$").
ExecStart=/bin/sh -c 'exec /usr/local/bin/martin --listen-addresses 127.0.0.1:3000 --workers 4 /opt/veetrax/maps/india.pmtiles $$(test -f /opt/veetrax/maps/us.pmtiles && echo /opt/veetrax/maps/us.pmtiles)'
Restart=on-failure
RestartSec=10
# Logs: journalctl -u veetrax-martin -f

[Install]
WantedBy=multi-user.target
