[Unit]
Description=VeeTrax geocoding (Photon 1.3, India) on localhost:2322
After=network-online.target

[Service]
User=veetrax
WorkingDirectory=/opt/veetrax/maps/photon
# Data: photon_data/ from download1.graphhopper.com/public/asia/india/photon-db-india-1.0-latest.tar.bz2
ExecStart=/usr/bin/java -Xms1g -Xmx3g -jar photon-1.3.0.jar serve -data-dir /opt/veetrax/maps/photon -listen-ip 127.0.0.1 -listen-port 2322 -j 4
Restart=on-failure
RestartSec=30
SuccessExitStatus=143
LimitNOFILE=65536
# Logs: journalctl -u veetrax-photon -f

[Install]
WantedBy=multi-user.target
