[Unit]
Description=VeeTrax gateway
After=network-online.target postgresql.service valkey-server.service
Wants=network-online.target

[Service]
User=veetrax
WorkingDirectory=/opt/veetrax/app/apps/api
EnvironmentFile=/opt/veetrax/app/apps/api/.env
# E4 security review L9: the optimiser token is for veetrax-api and veetrax-routing-worker only.
InaccessiblePaths=-/etc/veetrax/optimizer.env
# E4 re-check R3: a private /proc with hidepid=invisible (other users' processes are hidden). All VeeTrax units run as
# the same user "veetrax", and invisible does not hide same-user processes, so this is defence in depth only: separating
# the optimiser token from the other units for real needs a separate system user for veetrax-api / veetrax-routing-worker
# (or PrivatePIDs=yes, systemd >= 257). ProcSubset=pid is not set: it hides /proc/version, /proc/meminfo and
# /proc/cpuinfo, which the API's System Health (os.cpus / loadavg) and the Prisma engine's platform probe read.
ProtectProc=invisible
ExecStart=/usr/bin/node --max-old-space-size=512 dist/gateway/main.js
Restart=always
RestartSec=5
# Logs: journalctl -u veetrax-gateway -f

[Install]
WantedBy=multi-user.target
