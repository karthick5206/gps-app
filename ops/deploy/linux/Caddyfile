# VeeTrax production (Ubuntu): /etc/caddy/Caddyfile. Caddy gets and renews the HTTPS certificates itself.
# DNS (all DNS-only / grey cloud): app, @ (and www once added) and track -> the server.
# track.veetrax.com is for devices only: raw TCP ports, plus plain-HTTP dashcam uploads (block at the end).

app.veetrax.com {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# REST API (also live video streams) and live updates (WebSockets)
	handle /api/* {
		reverse_proxy 127.0.0.1:4000
	}
	handle /socket.io/* {
		reverse_proxy 127.0.0.1:4000
	}

	# Self-hosted map: vector tiles from Martin (/tiles/india/{z}/{x}/{y} -> martin /india/{z}/{x}/{y}); USA tiles as
	# source "us" and the composite "india,us" the styles use (make-styles.sh TILE_SOURCES)
	# The demo server (gps.mintplus.co.in) loads these map files too: allow only that site cross-origin.
	@tilecors path /tiles/*
	# defer: replaces (not duplicates) the header Martin itself sends on tiles
	header @tilecors {
		Access-Control-Allow-Origin "https://gps.mintplus.co.in"
		defer
	}

	@martin path /tiles/india/* /tiles/us/* /tiles/india,us/*
	handle @martin {
		uri strip_prefix /tiles
		header Cache-Control "public, max-age=86400"
		reverse_proxy 127.0.0.1:3000
	}
	# Styles, fonts and sprites (nothing is loaded from outside)
	handle_path /tiles/* {
		root * /opt/veetrax/maps/tiles
		header Cache-Control "public, max-age=86400"
		file_server
	}

	# Web app: hashed assets cached long, single-page app falls back to index.html
	handle {
		root * /opt/veetrax/app/apps/web/dist
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}

# The bare domain goes to the app until there is a landing page. Add www.veetrax.com here once its DNS record exists.
veetrax.com {
	redir https://app.veetrax.com{uri} permanent
}

# Dashcam photo / clip uploads over plain HTTP for firmware without HTTPS (Jimi JC400 / JC261: UPLOAD,http://track.veetrax.com/dvr/upload).
# Only this one path; everything else on this host is 404.
http://track.veetrax.com {
	handle /dvr/upload {
		rewrite * /api/dvr/jimi/upload?{query}
		reverse_proxy 127.0.0.1:4000
	}
	handle {
		respond 404
	}
}
