# VeeTrax production (Ubuntu): /etc/caddy/Caddyfile. Caddy gets and renews the HTTPS certificates itself.
# DNS (all DNS-only / grey cloud): app, @ (and www once added) and track -> the server.
# track.veetrax.com is for devices only: raw TCP ports, plus plain-HTTP dashcam uploads (block at the end).

app.veetrax.com {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# REST API (also live video streams) and live updates (WebSockets)
	handle /api/* {
		reverse_proxy 127.0.0.1:4000
	}
	handle /socket.io/* {
		reverse_proxy 127.0.0.1:4000
	}

	# Self-hosted map: vector tiles from Martin (/tiles/india/{z}/{x}/{y} -> martin /india/{z}/{x}/{y}); USA tiles as
	# source "us" and the composite "india,us" the styles use (make-styles.sh TILE_SOURCES)
	# Cross-origin map files: demo (gps.mintplus.co.in), VeeAssets (qr.mintplus.co.in, local dev :5173 / :8090) and glens.mintplus.co.in.
	# The allowed Origin is echoed back; any other Origin gets no Access-Control-Allow-Origin.
	# defer: replaces / removes the header Martin itself sends on tiles (Martin echoes every origin).
	@tilecors_ok {
		path /tiles/*
		header Origin https://gps.mintplus.co.in
		header Origin https://qr.mintplus.co.in
		header Origin https://glens.mintplus.co.in
		header Origin http://localhost:5173
		header Origin http://localhost:8090
		header Origin http://127.0.0.1:8090
	}
	@tilecors_no {
		path /tiles/*
		not {
			header Origin https://gps.mintplus.co.in
			header Origin https://qr.mintplus.co.in
			header Origin https://glens.mintplus.co.in
			header Origin http://localhost:5173
			header Origin http://localhost:8090
			header Origin http://127.0.0.1:8090
		}
	}
	header @tilecors_ok {
		Access-Control-Allow-Origin "{http.request.header.Origin}"
		Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
		Vary Origin
		defer
	}
	header @tilecors_no {
		-Access-Control-Allow-Origin
		-Access-Control-Allow-Credentials
		defer
	}
	@tilepreflight {
		method OPTIONS
		path /tiles/*
		header Origin https://gps.mintplus.co.in
		header Origin https://qr.mintplus.co.in
		header Origin https://glens.mintplus.co.in
		header Origin http://localhost:5173
		header Origin http://localhost:8090
		header Origin http://127.0.0.1:8090
	}
	handle @tilepreflight {
		header Access-Control-Allow-Headers "Content-Type, Range, If-None-Match, If-Modified-Since"
		header Access-Control-Max-Age "86400"
		respond 204
	}

	# Geocoding for VeeAssets (qrapi.mintplus.co.in on 166.0.242.121) -> local Photon.
	# Only GET /geo/api and /geo/reverse, only from 166.0.242.121 or 202.83.45.102, only with X-Geo-Key = GEO_KEY
	# (GEO_KEY comes from root-only /etc/caddy/geo.env via caddy.service.d/geo-key.conf). Else 403. No CORS.
	@geo path /geo /geo/*
	handle @geo {
		@geo_ok {
			method GET
			path /geo/api /geo/reverse
			remote_ip 166.0.242.121 202.83.45.102
			header X-Geo-Key {$GEO_KEY}
		}
		handle @geo_ok {
			uri strip_prefix /geo
			reverse_proxy 127.0.0.1:2322 {
				header_up -X-Geo-Key
			}
		}
		handle {
			respond 403
		}
	}

	@martin path /tiles/india/* /tiles/us/* /tiles/india,us/*
	handle @martin {
		uri strip_prefix /tiles
		header Cache-Control "public, max-age=86400"
		reverse_proxy 127.0.0.1:3000
	}
	# Styles, fonts and sprites (nothing is loaded from outside)
	# Styles change when map data changes (make-styles.sh): always revalidate (ETag); fonts / sprites cached a day.
	@styles path /tiles/styles/*
	handle @styles {
		uri strip_prefix /tiles
		root * /opt/veetrax/maps/tiles
		header Cache-Control "no-cache"
		file_server
	}
	handle_path /tiles/* {
		root * /opt/veetrax/maps/tiles
		header Cache-Control "public, max-age=86400"
		file_server
	}

	# Web app: hashed assets cached long, single-page app falls back to index.html
	handle {
		root * /opt/veetrax/app/apps/web/dist
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}

# The bare domain goes to the app until there is a landing page. Add www.veetrax.com here once its DNS record exists.
veetrax.com {
	redir https://app.veetrax.com{uri} permanent
}

# Dashcam photo / clip uploads over plain HTTP for firmware without HTTPS (Jimi JC400 / JC261: UPLOAD,http://track.veetrax.com/dvr/upload).
# Only this one path; everything else on this host is 404.
http://track.veetrax.com {
	handle /dvr/upload {
		rewrite * /api/dvr/jimi/upload?{query}
		reverse_proxy 127.0.0.1:4000
	}
	# SD-card recording name list (FILELIST,http://track.veetrax.com/dvr/filelist).
	handle /dvr/filelist {
		rewrite * /api/dvr/jimi/filelist
		reverse_proxy 127.0.0.1:4000
	}
	handle {
		respond 404
	}
}
