[Unit]
Description=VeeTrax API (REST + live updates)
After=network-online.target postgresql.service valkey-server.service
Wants=network-online.target

[Service]
User=veetrax
WorkingDirectory=/opt/veetrax/app/apps/api
EnvironmentFile=/opt/veetrax/app/apps/api/.env
# Optimiser token from its own file (E4 security review L9); only this unit and veetrax-routing-worker may read it.
Environment=OPTIMIZER_TOKEN_FILE=/etc/veetrax/optimizer.env
ExecStart=/usr/bin/node --max-old-space-size=512 dist/main.js
Restart=always
RestartSec=5
# Logs: journalctl -u veetrax-api -f

[Install]
WantedBy=multi-user.target
