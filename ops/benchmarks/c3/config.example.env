# C3 benchmark kit settings. Copy to a private file OUTSIDE the repo (e.g. ~/c3/c3.env, mode 0600), fill in, then:
#   set -a; source ~/c3/c3.env; set +a; bash ops/benchmarks/c3/run-all.sh --dry-run
# Never put production values here. Every script refuses veetrax.com hosts and 103.176.85.69.

# --- Safety (required by every script) -------------------------------------------------------------------------------
C3_TARGET=                         # the C3 staging host name or IP (NOT production)
C3_CONFIRM_NOT_PRODUCTION=         # must be: yes
C3_ALLOW_AVX=0                     # 1 only if AVX cannot be hidden: results get "AVX present, not production-comparable"
C3_SSH=                            # ssh alias of the C3 host (offbox scripts read its /proc/cpuinfo, systemd, psql)
# C3_DRY_RUN=1                     # or pass --dry-run: validate and print the plan, send nothing

# --- Services (from the load-generator machine: ssh tunnels to the C3 host's loopback ports) ------------------------
# ssh -N -L 18989:127.0.0.1:8989 -L 18090:127.0.0.1:8090 "$C3_SSH"
C3_GH_URL=http://127.0.0.1:18989
C3_OPTIMIZER_URL=http://127.0.0.1:18090
C3_OPTIMIZER_TOKEN_FILE=           # private copy of the C3 host's /etc/veetrax/optimizer.env (0600); never production's
C3_API_URL=                        # the C3 API base URL, e.g. https://c3-staging.example.test
C3_METRICS_TOKEN_FILE=             # file with the C3 API's METRICS_TOKEN (0600)
C3_GATEWAY_HOST=                   # the C3 host's GT06 gateway address
C3_GATEWAY_PORT=5023
C3_DB_NAME=veetrax_etms_test       # doc 11 §5.4: the C3 database built from migrations + seed + synthetic data
C3_GH_PID=                         # only when B2 runs ON the C3 host: GraphHopper JVM pid (GH CPU-seconds)

# --- Optimiser venv (on-host scripts B3 / B4 / B5) ---------------------------------------------------------------------
C3_PYTHON=/opt/veetrax/venvs/routing-optimizer/bin/python

# --- Rates: REQUIRED for B6 and R-5. No document gives them: TBD (owner/ops), measured from production GraphHopper
# access logs (requests/s at the busiest tracking hour). Do not guess.
C3_TRACKER_ROUTE_RPS=
C3_MATCH_RPS=

# --- Optional sizes (defaults shown) -------------------------------------------------------------------------------------
# C3_B1_PAIRS=400
# C3_B2_SIZES=100,200,400   C3_B2_CONCURRENCY=4
# C3_B3_N=200  C3_B3_KS=20,40,60  C3_B3_LIMIT_S=60  C3_B3_REPEATS=1  C3_B3_VEHICLES=10
# C3_SOLVE_SIZES=100,200,300,500  C3_B4_LIMITS=10,30,60,120
# C3_B6_DURATION_S=300  C3_B6_MATRIX_N=200
# C3_R5_DURATION_S=600  C3_R5_MATRIX_N=200  C3_R5_DEVICES=1000  C3_R5_FIX_INTERVAL_S=10  C3_R5_IMEI_START=868120007000001
# C3_RESULTS_DIR=ops/benchmarks/c3/results   (git-ignored by results/.gitignore)
