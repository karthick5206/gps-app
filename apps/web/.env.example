# Vector basemap style URLs (MapLibre style JSON) from the self-hosted tile server (ops/deploy/linux/maps:
# Martin + Caddy under /tiles). Production: https://app.veetrax.com/tiles/styles/{liberty,positron,dark}.json
# Unset = the same files on the page's own origin (/tiles/styles/...); there is no outside default (G8).
# Local development without Martin shows blank maps. A developer may opt in to a public style host (e.g. OpenFreeMap)
# explicitly in .env.local, never in .env; `npm run build` fails if an outside map host ends up in the bundle.
VITE_MAP_STYLE_STANDARD=https://app.veetrax.com/tiles/styles/liberty.json
VITE_MAP_STYLE_LIGHT=https://app.veetrax.com/tiles/styles/positron.json
VITE_MAP_STYLE_DARK=https://app.veetrax.com/tiles/styles/dark.json
# Font for marker labels and cluster counts; must exist on the style's glyph server.
VITE_MAP_FONT=Noto Sans Bold
