# Vector basemap style URLs (MapLibre style JSON). Defaults: OpenFreeMap (free, no key).
# Replace with the self-hosted Martin/OpenMapTiles styles in production.
VITE_MAP_STYLE_LIGHT=https://tiles.openfreemap.org/styles/positron
VITE_MAP_STYLE_DARK=https://tiles.openfreemap.org/styles/dark
# Font for marker labels and cluster counts; must exist on the style's glyph server.
VITE_MAP_FONT=Noto Sans Bold
