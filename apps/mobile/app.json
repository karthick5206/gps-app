{
  "expo": {
    "name": "VeeTrax",
    "slug": "veetracer",
    "version": "0.8.4",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "veetrax",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.sasvata.veetrax",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Save the place where a photo note was taken and show your position.",
        "NSCameraUsageDescription": "Take a profile photo or a photo of a bill or place to save with its location.",
        "NSPhotoLibraryUsageDescription": "Choose a photo for your profile or a photo note."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E5E57",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sasvata.veetrax",
      "versionCode": 84,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E5E57",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#0E5E57",
          "sounds": [
            "./assets/sounds/sos_siren.wav"
          ]
        }
      ],
      "expo-localization",
      [
        "../../tooling/expo/with-release-signing.js",
        {
          "keyAlias": "veetrax"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Take a profile photo or a photo of a bill or place to save with its location.",
          "photosPermission": "Choose a photo for your profile or a photo note.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "43750026-33cd-4c93-85cc-a3fdad10d8f4"
      }
    },
    "owner": "karthick5206"
  }
}
