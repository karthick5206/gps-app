{
  "name": "@veetracer/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start:dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:gateway": "node dist/gateway/main.js",
    "start:processor": "node dist/processor/main.js",
    "start:notifier": "node dist/notifier/main.js",
    "start:summarizer": "node dist/summarizer/main.js",
    "gateway:dev": "tsx watch src/gateway/main.ts",
    "processor:dev": "tsx watch src/processor/main.ts",
    "notifier:dev": "tsx watch src/notifier/main.ts",
    "summarizer:dev": "tsx watch src/summarizer/main.ts",
    "sim": "tsx src/simulator/gt06-sim.ts",
    "sim:register": "tsx src/simulator/register.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "test": "jest"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^12.0.0",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/platform-socket.io": "^11.2.7",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^11.2.7",
    "@prisma/client": "^6.19.3",
    "@veetracer/shared": "^0.1.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.2",
    "exceljs": "^4.4.0",
    "ioredis": "^5.11.1",
    "nodemailer": "^7.0.13",
    "pdfmake": "^0.3.12",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.7",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfmake": "^0.3.3",
    "jest": "^29.7.0",
    "prisma": "^6.19.3",
    "socket.io-client": "^4.8.4",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "jest": {
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "testEnvironment": "node"
  }
}
