DATABASE_URL=postgresql://karthickramasamy@localhost:5432/veetracer
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-long-random-string
API_PORT=4000
GT06_PORT=5023
# JT/T 808 dashcam / MDVR listener (0 disables)
JT808_PORT=6808
# Teltonika FMB/FMC listener (0 disables)
TELTONIKA_PORT=5027
# Optional: capture raw frames of these IMEIs (or "all") to var/logs/capture-<protocol>.log
# GATEWAY_CAPTURE=
WEB_URL=http://localhost:5173
OTP_DEV_ECHO=true
MAIL_DEV_ECHO=true
CORS_ORIGINS=http://localhost:5173

# Reverse geocoding: none | nominatim | photon (self-hosted). Public Nominatim is dev-only (≤1 req/s).
GEOCODER=nominatim
GEOCODER_URL=https://nominatim.openstreetmap.org

# ── Ingest ──
# Cap of the vt:positions stream (XADD MAXLEN ~). Entries the processor hasn't finished are lost once the backlog
# exceeds this, so size it for the longest processor outage you want to survive: rate/s × seconds (2M ≈ 33 min at 1,000/s).
# POSITIONS_STREAM_MAXLEN=2000000

# ── System Health (Platform → System Health, docs/MONITORING.md) ──
# Extra recipients of system alert e-mails besides the Super Admin (comma separated)
# SYSTEM_ALERT_EMAILS=ops@example.com,noc@example.com
# Minutes before the same check e-mails again (escalations WARN → CRITICAL always e-mail)
# SYSTEM_ALERT_COOLDOWN_MIN=15
# Processes that must be running (default all): api,gateway,processor,notifier,summarizer
# SYSTEM_HEALTH_ROLES=api,gateway,processor,notifier,summarizer
# Directory whose disk is checked for free space (default apps/api/var)
# HEALTH_DATA_DIR=/var/lib/veetrax
# Bearer token for GET /api/metrics (Prometheus); a Super Admin access token also works
# METRICS_TOKEN=
# SYSTEM_MONITOR=off disables heartbeats/evaluation in this API instance
# Thresholds (defaults shown)
# HEALTH_QUEUE_LAG_WARN=5000
# HEALTH_QUEUE_LAG_CRIT=50000
# HEALTH_PENDING_AGE_WARN_SEC=60
# HEALTH_BUFFER_WARN_MIN=30
# HEALTH_BUFFER_CRIT_MIN=10
# HEALTH_HEARTBEAT_STALE_SEC=15
# HEALTH_DB_LATENCY_WARN_MS=200
# HEALTH_DB_ERROR_WINDOW_SEC=120
# HEALTH_VALKEY_MEM_WARN_PCT=80
# HEALTH_VALKEY_MEM_CRIT_PCT=90
# HEALTH_DISK_WARN_PCT=15
# HEALTH_DISK_CRIT_PCT=5
# HEALTH_EVENT_LOOP_WARN_MS=200
# HEALTH_NO_POSITIONS_WARN_MIN=5
# HEALTH_NOTIFY_FAIL_WARN_PCT=20
# HEALTH_NOTIFY_FAIL_WINDOW_MIN=15
# HEALTH_NOTIFY_FAIL_MIN_ATTEMPTS=5
