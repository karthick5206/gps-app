DATABASE_URL=postgresql://karthickramasamy@localhost:5432/veetracer
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-long-random-string
API_PORT=4000
GT06_PORT=5023
# JT/T 808 dashcam / MDVR listener (0 disables)
JT808_PORT=6808
# AIS-140 VLT listener, iTriangle TS101 (0 disables)
AIS140_PORT=5030
# JT/T 1078 dashcam video (gateway): public media TCP port (0 disables), host dashcams connect to,
# localhost-only HTTP-FLV port the API proxies, max concurrent device streams.
MEDIA_PORT=7612
MEDIA_PUBLIC_HOST=track.mintplus.co.in
MEDIA_HTTP_PORT=4110
MEDIA_MAX_STREAMS=8
# Su-standard ADAS / DMS alarm attachment server (photos / clips); 0 disables
ATTACH_PORT=7613
# Teltonika FMB/FMC listener (0 disables)
TELTONIKA_PORT=5027
# Optional: capture raw frames of these IMEIs (or "all") to var/logs/capture-<protocol>.log
# GATEWAY_CAPTURE=
WEB_URL=http://localhost:5173
OTP_DEV_ECHO=true
MAIL_DEV_ECHO=true
CORS_ORIGINS=http://localhost:5173

# Reverse geocoding: none | nominatim | photon (self-hosted). Public Nominatim is dev-only (≤1 req/s).
GEOCODER=nominatim
GEOCODER_URL=https://nominatim.openstreetmap.org

# Licences & billing — Razorpay online payments (all three required; when any is missing, online payment is hidden
# and only offline payments recorded by the Super Admin / partner are available).
# Webhook: https://<host>/api/billing/razorpay/webhook, events payment.captured, order.paid, payment.failed.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Hourly licence job (expiry reminders, seat rebalancing): on | off
LICENCE_JOB=on
