generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  BUSINESS
  INDIVIDUAL
  /// Personal account with phones of other people (added with their OTP consent) or several own phones.
  FAMILY
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
}

enum DataScope {
  COMPANY
  ASSIGNED
}

enum ObjectType {
  VEHICLE
  PERSON
  ASSET
  PET
}

enum VehicleType {
  CAR
  BIKE
  TRUCK
  BUS
  SCHOOL_BUS
  VAN
  AUTO
  OTHER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGIN_FAILED
  LOGOUT
  PASSWORD_RESET
  /// Sensitive read (ETMS: home address, phone reveal, live location, manifest; doc 05 §1). Added by etms_accounts.
  ACCESS
}

model Partner {
  id             String          @id @default(uuid()) @db.Uuid
  name           String
  slug           String          @unique
  createdAt      DateTime        @default(now())
  /// The reseller's own company account: its admins (with billing permission) manage the partner pool.
  homeCompanyId  String?         @unique @db.Uuid
  /// Partner price overrides per licence type (paise, GST-inclusive); missing = platform price.
  pricesPaise    Json            @default("{}")
  updatedAt      DateTime        @updatedAt
  companies      Company[]
  billingProfile BillingProfile?
  licenceSeats   LicenceSeat[]
  licenceOrders  LicenceOrder[]
  invoices       Invoice[]
  creditNotes    CreditNote[]
  /// Device inventory (Phase B): partner-owned locations / suppliers / held stock (only platform screens write them).
  stockLocations StockLocation[]
  suppliers      Supplier[]
  heldStock      DeviceStock[]
  stockMovements StockMovement[]
}

model Company {
  id            String        @id @default(uuid()) @db.Uuid
  partnerId     String        @db.Uuid
  name          String
  accountType   AccountType   @default(BUSINESS)
  status        CompanyStatus @default(ACTIVE)
  timezone      String        @default("Asia/Kolkata")
  distanceUnit  String        @default("km")
  retentionDays Int           @default(90)
  settings      Json          @default("{}")
  isPlatform    Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  partner        Partner           @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  branches       Branch[]
  sharedVehicles VehicleShare[]
  users          User[]
  roles          Role[]
  devices        Device[]
  objects        TrackedObject[]
  vehicleGroups  VehicleGroup[]
  drivers        Driver[]
  documents      Document[]
  pois           Poi[]
  lookups        Lookup[]
  auditLogs      AuditLog[]
  apiKeys        ApiKey[]
  webhooks       WebhookEndpoint[]
  billingProfile BillingProfile?
  licenceSeats   LicenceSeat[]
  licenceOrders  LicenceOrder[]
  invoices       Invoice[]
  creditNotes    CreditNote[]
  stockMovements StockMovement[]
  /// ETMS (D1): agreements where this company is the transport provider / the corporate customer.
  transportAgreementsAsProvider TransportServiceAgreement[] @relation("TransportAgreementProvider")
  transportAgreementsAsCustomer TransportServiceAgreement[] @relation("TransportAgreementCustomer")
}

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  name      String
  code      String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  objects TrackedObject[]
  users   UserBranch[]
  drivers Driver[]
  pois    Poi[]

  @@unique([companyId, name])
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  companyId        String    @db.Uuid
  name             String
  email            String?   @unique
  mobile           String?   @unique
  passwordHash     String?
  isSuperAdmin     Boolean   @default(false)
  managerId        String?   @db.Uuid
  isActive         Boolean   @default(true)
  preferences      Json      @default("{\"theme\":\"system\"}")
  lastLoginAt      DateTime?
  /// "Mark all alerts as read": alerts that occurred at or before this time count as read for this user.
  alertsReadBefore DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  manager        User?           @relation("UserManager", fields: [managerId], references: [id], onDelete: Restrict)
  reports        User[]          @relation("UserManager")
  roles          UserRole[]
  branches       UserBranch[]
  objects        UserObject[]
  sessions       Session[]
  passwordResets PasswordReset[]
  pushTokens     PushToken[]
  licenceSeat    LicenceSeat?

  @@index([companyId])
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @db.Uuid
  name        String
  description String?
  isSystem    Boolean   @default(false)
  dataScope   DataScope @default(ASSIGNED)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  permissions RolePermission[]
  users       UserRole[]

  @@unique([companyId, name])
}

model RolePermission {
  roleId  String   @db.Uuid
  menu    String
  actions String[]

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, menu])
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
}

model UserBranch {
  userId   String @db.Uuid
  branchId String @db.Uuid

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@id([userId, branchId])
  @@index([branchId])
}

model UserObject {
  userId   String @db.Uuid
  objectId String @db.Uuid

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  object TrackedObject @relation(fields: [objectId], references: [id], onDelete: Restrict)

  @@id([userId, objectId])
  @@index([objectId])
}

model DeviceModel {
  id                String   @id @default(uuid()) @db.Uuid
  brand             String
  model             String
  protocol          String
  capabilities      String[]
  fields            Json     @default("[]")
  commands          Json     @default("[]")
  timeOffsetMinutes Int      @default(0)
  filterDefaults    Json     @default("{}")
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  devices    Device[]
  stockItems StockItem[]

  @@unique([brand, model])
}

model Device {
  id               String    @id @default(uuid()) @db.Uuid
  companyId        String?   @db.Uuid
  modelId          String    @db.Uuid
  uniqueId         String    @unique
  simNumber        String?
  simOperator      String?
  firmware         String?
  /// SIM ICCID reported by the tracker itself (Concox info packet, Teltonika IO 11/14, ICCID# / getimeiccid reply).
  iccid            String?
  /// Firmware version reported by the tracker (VERSION# / getver reply); `firmware` stays the admin's own note.
  firmwareReported String?
  deviceInfoAt     DateTime? @db.Timestamptz(3)
  ingestToken      String    @unique
  /// Shipped to a customer: code printed on the help sheet; the customer claims the device with IMEI + code.
  claimCode        String?   @unique
  /// Only this customer (email or +91 mobile) may claim it.
  reservedEmail    String?
  reservedMobile   String?
  reservedName     String?
  /// Courier / order note shown in Shipments (e.g. "DTDC D12345678 · order 1024").
  shipmentNote     String?
  shippedAt        DateTime? @db.Timestamptz(3)
  claimedAt        DateTime? @db.Timestamptz(3)
  /// Tracker app (mobile tracker model): extra address that gets the activation code (admins always get it).
  activationEmail  String?
  /// Tracker app: latest phone health report (permissions, battery / data restrictions, last stop) and when.
  /// Tracker app: the company requires tracking on this phone; the app refuses Stop and undoes any stop (1.3.4+).
  trackingRequired Boolean   @default(false)
  trackerHealth    Json?
  trackerHealthAt  DateTime? @db.Timestamptz(3)
  isActive         Boolean   @default(true)
  lastSeenAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  company         Company?               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  model           DeviceModel            @relation(fields: [modelId], references: [id], onDelete: Restrict)
  assignments     DeviceAssignment[]
  licenceSeat     LicenceSeat?
  ioSensors       IoSensorConfig[]
  trackerCodes    MobileTrackerCode[]
  trackerSessions MobileTrackerSession[]
  trackerEvents   TrackerEvent[]
  /// Device inventory (Phase B): side tables only; inventory code never writes this Device row.
  stock           DeviceStock?
  stockMovements  StockMovement[]
  /// SIM management (Phase C): side tables only; SIM code never writes this Device row.
  simAssignments  SimAssignment[]
  simEvents       SimEvent[]

  @@index([companyId])
}

model TrackedObject {
  id               String       @id @default(uuid()) @db.Uuid
  companyId        String       @db.Uuid
  branchId         String?      @db.Uuid
  type             ObjectType   @default(VEHICLE)
  vehicleType      VehicleType?
  name             String
  plateNumber      String?
  make             String?
  model            String?
  color            String?
  icon             String?
  speedLimitKph    Int?
  odometerOffsetKm Float        @default(0)
  /// Set while the vehicle is in the workshop: alerts are suppressed and it is listed separately on the criticality board.
  maintenanceSince DateTime?    @db.Timestamptz(3)
  maintenanceNote  String?
  customFields     Json         @default("{}")
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  company         Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch          Branch?              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  assignments     DeviceAssignment[]
  groups          VehicleGroupMember[]
  users           UserObject[]
  remarks         ObjectRemark[]
  commands        DeviceCommand[]
  drivers         DriverAssignment[]
  documents       Document[]
  services        ServiceReminder[]
  serviceLog      ServiceRecord[]
  fuelConfig      FuelConfig?
  parkingSchedule ParkingSchedule?
  liveShares      LiveShare[]
  expenses        Expense[]
  fuelEvents      FuelEvent[]
  ioSessions      IoSession[]
  driverEvents    DriverEvent[]
  attendanceDays    AttendanceDay[]
  sharedWith        VehicleShare[]
  attendanceOutings AttendanceOuting[]
  attendanceSelfies AttendanceSelfie[]
  stockMovements    StockMovement[]

  @@index([companyId, branchId])
}

/// Support notes on a vehicle (e.g. "SIM recharged", "device removed for repair"), shown on the criticality board.
model ObjectRemark {
  id          String        @id @default(uuid()) @db.Uuid
  companyId   String        @db.Uuid
  objectId    String        @db.Uuid
  note        String
  createdById String?       @db.Uuid
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  object      TrackedObject @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@index([objectId, createdAt(sort: Desc)])
  @@index([companyId, createdAt(sort: Desc)])
}

/// At most one open (toTime null) row per device and per object: partial unique indexes in the init migration.
model DeviceAssignment {
  id       String    @id @default(uuid()) @db.Uuid
  deviceId String    @db.Uuid
  objectId String    @db.Uuid
  fromTime DateTime  @default(now())
  toTime   DateTime?

  device Device        @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  object TrackedObject @relation(fields: [objectId], references: [id], onDelete: Restrict)

  @@index([deviceId])
  @@index([objectId])
}

/// A person who drives company vehicles; identified on the tracker by an RFID card / iButton (`rfidTag`).
model Driver {
  id                   String    @id @default(uuid()) @db.Uuid
  companyId            String    @db.Uuid
  branchId             String?   @db.Uuid
  name                 String
  mobile               String?
  employeeId           String?
  licenseNo            String?
  licenseExpiry        DateTime? @db.Date
  /// Hex, upper case, without leading zeros (normalizeRfidTag); unique per company.
  rfidTag              String?
  notes                String?
  isActive             Boolean   @default(true)
  /// Last licence-expiry reminder raised (EXPIRING | EXPIRED) for licenseExpiry; reset when the expiry changes.
  licenseNotifiedState String?
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(3)

  company      Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch       Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  assignments  DriverAssignment[]
  documents    Document[]
  driverEvents DriverEvent[]

  @@unique([companyId, rfidTag])
  @@unique([companyId, employeeId])
  @@index([companyId, name])
}

/// Who drove which vehicle when. At most one open (toTime null) row per object and per driver (partial unique indexes in the migration).
model DriverAssignment {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @db.Uuid
  driverId    String    @db.Uuid
  objectId    String    @db.Uuid
  fromTime    DateTime  @db.Timestamptz(3)
  toTime      DateTime? @db.Timestamptz(3)
  /// MANUAL (assigned in the app) or RFID (card swipe on the tracker).
  source      String
  createdById String?   @db.Uuid

  driver Driver        @relation(fields: [driverId], references: [id], onDelete: Cascade)
  object TrackedObject @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@index([objectId, fromTime(sort: Desc)])
  @@index([driverId, fromTime(sort: Desc)])
  @@index([companyId, fromTime(sort: Desc)])
}

/// RC, insurance, PUC, licence… of a vehicle (objectId) or a driver (driverId); exactly one is set (CHECK in the migration).
model Document {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String    @db.Uuid
  objectId      String?   @db.Uuid
  driverId      String?   @db.Uuid
  /// DOCUMENT_TYPE lookup code.
  type          String
  number        String?
  issuedOn      DateTime? @db.Date
  expiresOn     DateTime? @db.Date
  reminderDays  Int       @default(30)
  notes         String?
  /// Attached scan / photo, stored under var/documents/.
  fileName      String?
  filePath      String?
  fileType      String?
  fileSize      Int?
  /// Last reminder alert raised (EXPIRING | EXPIRED); reset when the expiry changes. Makes the reminders job idempotent.
  notifiedState String?
  createdById   String?   @db.Uuid
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  company Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  object  TrackedObject? @relation(fields: [objectId], references: [id], onDelete: Cascade)
  driver  Driver?        @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([companyId, expiresOn])
  @@index([objectId])
  @@index([driverId])
}

/// Periodic maintenance of a vehicle by date and/or odometer; dueAt / dueOdometerKm = last service + interval.
model ServiceReminder {
  id                 String    @id @default(uuid()) @db.Uuid
  companyId          String    @db.Uuid
  objectId           String    @db.Uuid
  title              String
  intervalKm         Int?
  intervalDays       Int?
  lastDoneAt         DateTime? @db.Date
  lastDoneOdometerKm Float?
  dueAt              DateTime? @db.Date
  dueOdometerKm      Float?
  notifyBeforeKm     Int       @default(500)
  notifyBeforeDays   Int       @default(7)
  notes              String?
  isActive           Boolean   @default(true)
  /// Last reminder alert raised for the current due point (DUE_SOON | OVERDUE); reset when it rolls forward.
  notifiedState      String?
  createdById        String?   @db.Uuid
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)

  object  TrackedObject   @relation(fields: [objectId], references: [id], onDelete: Cascade)
  records ServiceRecord[]

  @@index([companyId])
  @@index([objectId])
}

/// One completed service (history), optionally of a reminder.
model ServiceRecord {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  objectId    String   @db.Uuid
  reminderId  String?  @db.Uuid
  title       String
  doneAt      DateTime @db.Date
  odometerKm  Float?
  cost        Float?
  notes       String?
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  object   TrackedObject    @relation(fields: [objectId], references: [id], onDelete: Cascade)
  reminder ServiceReminder? @relation(fields: [reminderId], references: [id], onDelete: SetNull)

  @@index([objectId, doneAt(sort: Desc)])
  @@index([reminderId])
  @@index([companyId, doneAt(sort: Desc)])
}

model VehicleGroup {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Higher wins when an object's groups have conflicting alert settings.
  alertPriority Int @default(0)

  company Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  members VehicleGroupMember[]

  @@unique([companyId, name])
}

model VehicleGroupMember {
  groupId  String @db.Uuid
  objectId String @db.Uuid

  group  VehicleGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  object TrackedObject @relation(fields: [objectId], references: [id], onDelete: Restrict)

  @@id([groupId, objectId])
  @@index([objectId])
}

/// System rows have companyId null; a partial unique index on (type, code) for them lives in the init migration.
model Lookup {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String?  @db.Uuid
  type      String
  code      String
  label     String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, type, code])
  @@index([type])
}

/// No foreign keys: high-volume table, becomes a Timescale hypertable when the extension is available.
model Position {
  objectId   String?  @db.Uuid
  deviceId   String   @db.Uuid
  fixTime    DateTime @db.Timestamptz(3)
  serverTime DateTime @db.Timestamptz(3)
  lat        Float
  lng        Float
  speedKph   Float    @db.Real
  course     Int      @db.SmallInt
  altitude   Float?   @db.Real
  satellites Int?     @db.SmallInt
  valid      Boolean
  ignition   Boolean?
  flags      Int      @default(0)
  attributes Json     @default("{}")

  @@id([deviceId, fixTime])
  @@index([objectId, fixTime(sort: Desc)])
}

model RawPacket {
  id            BigInt   @id @default(autoincrement())
  uniqueId      String?
  protocol      String
  remoteAddress String?
  receivedAt    DateTime @db.Timestamptz(3)
  hex           String

  @@index([receivedAt])
  @@index([uniqueId, receivedAt(sort: Desc)])
}

model UnknownDevice {
  uniqueId      String   @id
  protocol      String
  remoteAddress String?
  firstSeenAt   DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  packetCount   Int      @default(0)
}

model AuditLog {
  id        String      @id @default(uuid()) @db.Uuid
  companyId String?     @db.Uuid
  userId    String?     @db.Uuid
  action    AuditAction
  entity    String
  entityId  String?
  changes   Json?
  ip        String?
  createdAt DateTime    @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId, createdAt(sort: Desc)])
  @@index([entity, entityId])
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @unique
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushTokens PushToken[]

  @@index([userId])
}

/// Mobile app push registration (Expo push token). Tied to the sign-in session: no pushes once it is revoked or expired.
model PushToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  sessionId  String?  @db.Uuid
  token      String   @unique
  platform   String
  deviceName String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OtpCode {
  id         String    @id @default(uuid()) @db.Uuid
  mobile     String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([mobile, createdAt(sort: Desc)])
}

model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ───────────────────────────── M2a: geofences, alerts, templates, history, reports ─────────────────────────────

enum GeofenceType {
  CIRCLE
  POLYGON
  RECTANGLE
}

enum GeofenceMode {
  NORMAL
  NO_GO
  KEEP_IN
}

enum AlertLevel {
  COMPANY
  BRANCH
  GROUP
  OBJECT
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertStatus {
  NEW
  ACKNOWLEDGED
  RESOLVED
}

enum NotifyChannel {
  INAPP
  EMAIL
  SMS
  WHATSAPP
  PUSH
  ARATTAI
}

enum RecipientMode {
  DEFAULT
  ADD
  ONLY
  NONE
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
}

enum ReportFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum ReportPeriod {
  DAY
  WEEK
  MONTH
}

enum ReportFormat {
  XLSX
  PDF
  CSV
}

enum RunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

/// geometry: {type:'CIRCLE',center:{lat,lng},radiusM} | {type:'POLYGON'|'RECTANGLE',points:[{lat,lng}]}; bbox columns speed up candidate lookup.
model Geofence {
  id            String       @id @default(uuid()) @db.Uuid
  companyId     String       @db.Uuid
  branchId      String?      @db.Uuid
  name          String
  category      String       @default("OTHER")
  type          GeofenceType
  geometry      Json
  minLat        Float
  minLng        Float
  maxLat        Float
  maxLng        Float
  color         String       @default("#0f766e")
  address       String?
  description   String?
  mode          GeofenceMode @default(NORMAL)
  notifyEnter   Boolean      @default(true)
  notifyExit    Boolean      @default(true)
  maxStayMin    Int?
  speedLimitKph Int?
  timeWindows   Json         @default("[]")
  appliesToAll  Boolean      @default(true)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  targets GeofenceTarget[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
}

/// Fuel sensor settings of a vehicle. source: none | can_level_pct | can_level_l | lls | analog.
/// calibration: [[raw, litres], …] ascending (LLS units or analog mV); refillMinL null = max(10 L, 5 % of the tank).
model FuelConfig {
  objectId        String   @id @db.Uuid
  companyId       String   @db.Uuid
  source          String   @default("none")
  tankCapacityL   Float?
  calibration     Json     @default("[]")
  refillMinL      Float?
  drainMinL       Float    @default(8)
  drainWindowMin  Int      @default(10)
  smoothingWindow Int      @default(5)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  object      TrackedObject @relation(fields: [objectId], references: [id], onDelete: Cascade)
  licenceSeat LicenceSeat?

  @@index([companyId])
}

/// Refill or drain (possible theft) detected by the processor. type: REFILL | DRAIN.
model FuelEvent {
  id           String   @id @db.Uuid
  companyId    String   @db.Uuid
  objectId     String   @db.Uuid
  type         String
  startTime    DateTime @db.Timestamptz(3)
  endTime      DateTime @db.Timestamptz(3)
  litresBefore Float
  litresAfter  Float
  deltaL       Float
  lat          Float?
  lng          Float?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  object TrackedObject @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@unique([objectId, type, startTime])
  @@index([companyId, startTime(sort: Desc)])
}

/// AC / door sensor wired to a tracker (one row per device and kind; the wiring is on the device). kind: AC | DOOR; source: DIGITAL | ANALOG.
/// DIGITAL: `attribute` is a boolean (or 0/1) input, `invert` flips it. ANALOG: ON while minV ≤ value ≤ maxV (volts).
model IoSensorConfig {
  deviceId    String   @db.Uuid
  kind        String
  companyId   String?  @db.Uuid
  enabled     Boolean  @default(true)
  source      String   @default("ANALOG")
  attribute   String   @default("adc1")
  invert      Boolean  @default(false)
  minV        Float?
  maxV        Float?
  hysteresisV Float    @default(0.2)
  debounceSec Int      @default(10)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@id([deviceId, kind])
  @@index([companyId])
}

/// One period in one AC / door state, written by the processor (endTime null = still in that state).
model IoSession {
  id           String    @id @db.Uuid
  companyId    String    @db.Uuid
  objectId     String    @db.Uuid
  kind         String
  on           Boolean
  startTime    DateTime  @db.Timestamptz(3)
  endTime      DateTime? @db.Timestamptz(3)
  startLat     Float?
  startLng     Float?
  endLat       Float?
  endLng       Float?
  distanceKm   Float     @default(0)
  durationSec  Int       @default(0)
  /// Seconds of this period with the ignition off (AC running with the engine off).
  engineOffSec Int       @default(0)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @default(now()) @db.Timestamptz(3)

  object TrackedObject @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@index([companyId, startTime(sort: Desc)])
  @@index([objectId, kind, startTime])
}

/// Point of interest (customer site, depot, fuel station…): a stop within radiusM counts as a visit.
model Poi {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  branchId    String?  @db.Uuid
  name        String
  category    String   @default("OTHER")
  lat         Float
  lng         Float
  address     String?
  radiusM     Int      @default(100)
  icon        String?
  color       String   @default("#2563eb")
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch  Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([companyId, isActive])
  @@index([companyId, lat, lng])
}

/// kind: BRANCH | GROUP | OBJECT (used when appliesToAll = false).
model GeofenceTarget {
  geofenceId String @db.Uuid
  kind       String
  refId      String @db.Uuid

  geofence Geofence @relation(fields: [geofenceId], references: [id], onDelete: Cascade)

  @@id([geofenceId, kind, refId])
  @@index([refId])
}

/// One override row per (level, target, alert type). targetId = companyId for COMPANY level. Null fields inherit.
model AlertSetting {
  id          String         @id @default(uuid()) @db.Uuid
  companyId   String         @db.Uuid
  level       AlertLevel
  targetId    String         @db.Uuid
  alertType   String
  enabled     Boolean?
  params      Json           @default("{}")
  schedule    Json?
  cooldownMin Int?
  severity    AlertSeverity?
  channels    Json?
  /// Require acknowledgement for this alert type; null = inherit (default: shared `defaultRequireAck`).
  requireAck  Boolean?
  updatedById String?        @db.Uuid
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([companyId, level, targetId, alertType])
  @@index([companyId])
}

/// alertType '*' and severity '*' = applies to all. entries: RecipientEntry[].
model RecipientList {
  id        String        @id @default(uuid()) @db.Uuid
  companyId String        @db.Uuid
  level     AlertLevel
  targetId  String        @db.Uuid
  alertType String        @default("*")
  severity  String        @default("*")
  channel   NotifyChannel
  mode      RecipientMode @default(DEFAULT)
  entries   Json          @default("[]")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([companyId, level, targetId, alertType, channel, severity])
  @@index([companyId])
}

model AlertSnooze {
  id          String     @id @default(uuid()) @db.Uuid
  companyId   String     @db.Uuid
  level       AlertLevel
  targetId    String     @db.Uuid
  alertTypes  String[]
  until       DateTime
  reason      String?
  createdById String?    @db.Uuid
  createdAt   DateTime   @default(now())

  @@index([companyId, until])
}

/// companyId null = system pack. settings: array of AlertSetting-like objects without level/target.
model AlertPack {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String?  @db.Uuid
  name        String
  description String?
  settings    Json     @default("[]")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, name])
}

/// High volume: no foreign keys.
model Alert {
  id          String        @id @default(uuid()) @db.Uuid
  companyId   String        @db.Uuid
  objectId    String        @db.Uuid
  deviceId    String?       @db.Uuid
  type        String
  severity    AlertSeverity
  message     String
  lat         Float?
  lng         Float?
  address     String?
  geofenceId  String?       @db.Uuid
  data        Json          @default("{}")
  occurredAt  DateTime      @db.Timestamptz(3)
  createdAt   DateTime      @default(now())
  status      AlertStatus   @default(NEW)
  ackById     String?       @db.Uuid
  ackAt       DateTime?
  ackNote     String?
  /// Needs acknowledgement: resolved from Alert Settings when the alert is raised (later setting changes don't rewrite it).
  ackRequired Boolean       @default(false)

  @@index([companyId, occurredAt(sort: Desc)])
  @@index([objectId, occurredAt(sort: Desc)])
  /// Unread count / NEW filters: company + status + recent first.
  @@index([companyId, status, occurredAt(sort: Desc)])
}

/// Per-user "read" mark for one alert (opening it). No foreign keys: Alert is high-volume and has none;
/// retention removes reads together with their alerts. Acknowledged alerts count as read for everyone.
model AlertRead {
  alertId String   @db.Uuid
  userId  String   @db.Uuid
  readAt  DateTime @default(now()) @db.Timestamptz(3)

  @@id([alertId, userId])
  @@index([userId, readAt])
}

model NotificationLog {
  id         String             @id @default(uuid()) @db.Uuid
  companyId  String             @db.Uuid
  alertId    String?            @db.Uuid
  channel    NotifyChannel
  recipient  String
  templateId String?            @db.Uuid
  subject    String?
  body       String
  status     NotificationStatus
  error      String?
  provider   String?
  createdAt  DateTime           @default(now())
  sentAt     DateTime?

  @@index([alertId])
  @@index([companyId, createdAt(sort: Desc)])
}

/// companyId null = system template (partial unique index in migration). approvalStatus: NA|DRAFT|PENDING|APPROVED|REJECTED.
model MessageTemplate {
  id             String        @id @default(uuid()) @db.Uuid
  companyId      String?       @db.Uuid
  purpose        String
  channel        NotifyChannel
  language       String        @default("en")
  name           String
  subject        String?
  body           String
  dltTemplateId  String?
  senderId       String?
  approvalStatus String        @default("NA")
  isActive       Boolean       @default(true)
  version        Int           @default(1)
  updatedById    String?       @db.Uuid
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  versions MessageTemplateVersion[]

  @@unique([companyId, purpose, channel, language])
  @@index([purpose, channel])
}

model MessageTemplateVersion {
  id          String   @id @default(uuid()) @db.Uuid
  templateId  String   @db.Uuid
  version     Int
  subject     String?
  body        String
  changedById String?  @db.Uuid
  createdAt   DateTime @default(now())

  template MessageTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, version])
}

model Trip {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @db.Uuid
  objectId     String   @db.Uuid
  startTime    DateTime @db.Timestamptz(3)
  endTime      DateTime @db.Timestamptz(3)
  startLat     Float
  startLng     Float
  endLat       Float
  endLng       Float
  startAddress String?
  endAddress   String?
  distanceKm   Float
  durationSec  Int
  idleSec      Int      @default(0)
  maxSpeedKph  Float
  avgSpeedKph  Float
  createdAt    DateTime @default(now())

  @@unique([objectId, startTime])
  @@index([companyId, startTime(sort: Desc)])
}

model Stop {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  objectId    String   @db.Uuid
  startTime   DateTime @db.Timestamptz(3)
  endTime     DateTime @db.Timestamptz(3)
  lat         Float
  lng         Float
  address     String?
  durationSec Int
  ignitionOn  Boolean
  createdAt   DateTime @default(now())

  @@unique([objectId, startTime])
  @@index([companyId, startTime(sort: Desc)])
}

/// Parking mode: weekly windows (company time zone) when the vehicle is armed; see packages/shared/src/parking.ts.
model ParkingSchedule {
  objectId       String   @id @db.Uuid
  companyId      String   @db.Uuid
  enabled        Boolean  @default(true)
  /// [{ days: number[] (0 = Sunday), startMin, endMin }]
  windows        Json     @default("[]")
  /// Every alert of the vehicle rings as an alarm while armed (else only the parking breach).
  alarmAllAlerts Boolean  @default(true)
  /// Reserved for SMS / IVR escalation when nobody acknowledges.
  escalation     Json     @default("{}")
  updatedById    String?  @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  object TrackedObject @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

/// Live location share link (public page /share/<token>), valid until expiresAt; the token is stored as a SHA-256 hash.
model LiveShare {
  id           String    @id @default(uuid()) @db.Uuid
  tokenHash    String    @unique
  companyId    String    @db.Uuid
  objectId     String    @db.Uuid
  createdById  String?   @db.Uuid
  note         String?
  hours        Int
  expiresAt    DateTime  @db.Timestamptz(3)
  revokedAt    DateTime? @db.Timestamptz(3)
  viewCount    Int       @default(0)
  lastViewedAt DateTime? @db.Timestamptz(3)
  /// Delivery ETA link: destination (the page shows the live ETA; the link ends 15 min after arrival).
  destLat      Float?
  destLng      Float?
  destLabel    String?
  arrivedAt    DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  object TrackedObject @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@index([objectId, createdAt(sort: Desc)])
  @@index([companyId])
}

/// Field staff attendance settings per company (see packages/shared/src/attendance.ts).
model AttendanceSettings {
  companyId   String   @id @db.Uuid
  enabled     Boolean  @default(false)
  /// Work-site geofence ids.
  geofenceIds String[] @default([])
  /// Staff covered; empty = every PERSON object.
  objectIds   String[] @default([])
  days        Int[]    @default([1, 2, 3, 4, 5, 6])
  startMin    Int      @default(570)
  endMin      Int      @default(1110)
  graceMin    Int      @default(15)
  /// Shifts for particular branches or people (AttendanceShiftDto[]); everyone else is on the default hours above.
  shifts             Json     @default("[]")
  shortExitMin       Int      @default(5)
  noSignalMin        Int      @default(20)
  halfDayMin         Int      @default(240)
  fullDayMin         Int      @default(480)
  outReminderMin     Int      @default(60)
  /// People who may attend at any branch's work site.
  anyBranchObjectIds String[] @default([])
  /// Management's choice: staff are asked for a selfie when they check in.
  selfieRequired     Boolean  @default(false)
  /// PHOTO, VIDEO (10 s) or PHOTO_AND_VIDEO (both from one recording).
  checkInProof       String   @default("PHOTO")
  /// Every company work site counts for everyone (other branches too).
  otherBranchSites   Boolean  @default(true)
  /// Straight from one work site to another within this many minutes = official duty; 0 = off.
  travelMaxMin       Int      @default(120)
  /// Short trips out up to this many minutes in total a day are not questioned; 0 = off.
  breakMin           Int      @default(45)
  /// The company counts overtime at all.
  overtimeOn         Boolean  @default(true)
  /// Less than this past the shift end is not overtime.
  overtimeMinMin     Int      @default(15)
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
}

/// A vehicle of one company shown, view only, to another. The owner keeps the vehicle, its device and its licence.
/// The other company sees it from startAt until endAt (open-ended when null). Only Super Admin manages these.
model VehicleShare {
  id           String    @id @default(uuid()) @db.Uuid
  objectId     String    @db.Uuid
  sharedWithId String    @db.Uuid
  startAt      DateTime  @default(now()) @db.Timestamptz(3)
  endAt        DateTime? @db.Timestamptz(3)
  /// The other company also sees the vehicle's alerts.
  alertsOn     Boolean   @default(false)
  createdById  String?   @db.Uuid
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  object     TrackedObject @relation(fields: [objectId], references: [id], onDelete: Cascade)
  sharedWith Company       @relation(fields: [sharedWithId], references: [id], onDelete: Cascade)

  @@unique([objectId, sharedWithId])
  @@index([sharedWithId])
}

/// One person's saved day: the figures as they stood and the rules used, so later setting changes or data retention
/// never alter past attendance. A manual correction is kept next to them.
model AttendanceDay {
  companyId      String    @db.Uuid
  objectId       String    @db.Uuid
  /// Local day, YYYY-MM-DD.
  day            String
  /// AttendanceRowDto as computed, without the correction; null while only a correction exists.
  row            Json?
  /// Shift and limits in force that day.
  rules          Json?
  overrideStatus String?
  overrideNote   String?
  overrideById   String?   @db.Uuid
  overrideAt     DateTime? @db.Timestamptz(3)
  savedAt        DateTime  @updatedAt @db.Timestamptz(3)

  object TrackedObject @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@id([objectId, day])
  @@index([companyId, day])
}

/// The selfie an employee took when checking in; the file is removed after ATTENDANCE_SELFIE_KEEP_DAYS.
model AttendanceSelfie {
  companyId String   @db.Uuid
  objectId  String   @db.Uuid
  /// Local day, YYYY-MM-DD.
  day       String
  takenAt   DateTime @db.Timestamptz(3)
  path      String
  type      String
  /// The phone's last position when the selfie was taken (null before 2026-11-06).
  lat       Float?
  lng       Float?
  /// Address burnt into the photo with the name, time and coordinates.
  address   String?
  /// The 10-second check-in video, when management asks for one.
  videoPath String?
  videoType String?
  videoAt   DateTime? @db.Timestamptz(3)

  object TrackedObject @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@id([objectId, day])
  @@index([takenAt])
}

/// An admin's decision about time outside the work site; leftAt is the exit it belongs to.
model AttendanceOuting {
  companyId   String   @db.Uuid
  objectId    String   @db.Uuid
  leftAt      DateTime @db.Timestamptz(3)
  /// OFFICIAL / PERSONAL / UNEXPLAINED, as it counts now (no row = unexplained). An admin's decision wins over the employee's answer.
  kind        String
  note        String?
  /// Set when an admin decided; the employee can then no longer change it.
  decidedById String?  @db.Uuid
  /// What the employee answered in the Tracker app.
  employeeKind String?
  employeeNote String?
  employeeAt   DateTime? @db.Timestamptz(3)
  decidedAt   DateTime @updatedAt @db.Timestamptz(3)

  object TrackedObject @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@id([objectId, leftAt])
  @@index([companyId])
}

/// Fuel & expense log entry (bill photo optional); odometerKm = VeeTrax odometer when entered.
model Expense {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  objectId    String   @db.Uuid
  kind        String
  at          DateTime @db.Timestamptz(3)
  amountPaise Int
  litres      Float?
  /// Fuel only: tank filled to full (mileage is measured between two full fill-ups).
  fullTank    Boolean  @default(true)
  odometerKm  Float?
  vendor      String?
  note        String?
  photoPath   String?
  photoType   String?
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  object TrackedObject @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@index([objectId, at(sort: Desc)])
  @@index([companyId, at(sort: Desc)])
}

/// Per object per local day (company timezone).
model DailySummary {
  objectId       String    @db.Uuid
  day            DateTime  @db.Date
  companyId      String    @db.Uuid
  distanceKm     Float     @default(0)
  runningSec     Int       @default(0)
  idleSec        Int       @default(0)
  stopSec        Int       @default(0)
  offlineSec     Int       @default(0)
  overspeedSec   Int       @default(0)
  overspeedCount Int       @default(0)
  tripCount      Int       @default(0)
  maxSpeedKph    Float     @default(0)
  avgSpeedKph    Float     @default(0)
  engineSec      Int       @default(0)
  firstStart     DateTime?
  lastStop       DateTime?
  updatedAt      DateTime  @updatedAt

  @@id([objectId, day])
  @@index([companyId, day])
}

/// Summarizer watermark per object; state holds the open trip/stop between runs.
model SummaryCursor {
  objectId       String   @id @db.Uuid
  processedUntil DateTime @db.Timestamptz(3)
  state          Json     @default("{}")
  updatedAt      DateTime @updatedAt
}

/// Days needing recomputation because late (out-of-order) positions arrived.
model SummaryDirtyDay {
  objectId  String   @db.Uuid
  day       DateTime @db.Date
  createdAt DateTime @default(now())

  @@id([objectId, day])
}

model ReportSchedule {
  id          String          @id @default(uuid()) @db.Uuid
  companyId   String          @db.Uuid
  ownerId     String          @db.Uuid
  name        String
  reportTypes String[]
  scope       Json            @default("{}")
  period      ReportPeriod    @default(DAY)
  frequency   ReportFrequency
  dayOfWeek   Int?
  dayOfMonth  Int?
  timeOfDay   String          @default("07:00")
  format      ReportFormat    @default(XLSX)
  recipients  String[]
  /// Report options per report type, e.g. { "HALT": { "minDurationMin": 45 } }. {} = API defaults (as before).
  options     Json            @default("{}")
  isActive    Boolean         @default(true)
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([companyId])
  @@index([isActive, nextRunAt])
}

model ReportRun {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String    @db.Uuid
  scheduleId    String?   @db.Uuid
  requestedById String?   @db.Uuid
  reportTypes   String[]
  params        Json      @default("{}")
  status        RunStatus @default(RUNNING)
  fileName      String?
  filePath      String?
  error         String?
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?

  @@index([scheduleId, startedAt(sort: Desc)])
  @@index([companyId, startedAt(sort: Desc)])
}

/// Reverse-geocoding cache keyed by coordinates rounded to 4 decimals (~11 m).
model AddressCache {
  key       String   @id
  address   String
  provider  String
  createdAt DateTime @default(now())
}

/// Written by the rules engine on every geofence entry/exit (independent of alert settings); read by reports.
model GeofenceVisit {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @db.Uuid
  objectId    String    @db.Uuid
  geofenceId  String    @db.Uuid
  enterTime   DateTime  @db.Timestamptz(3)
  exitTime    DateTime? @db.Timestamptz(3)
  durationSec Int?
  /// Where the object was when the entry / exit was confirmed; accuracy in metres when the tracker reports it.
  enterLat    Float?
  enterLng    Float?
  enterAccM   Float?    @db.Real
  exitLat     Float?
  exitLng     Float?
  exitAccM    Float?    @db.Real

  @@index([companyId, enterTime(sort: Desc)])
  @@index([objectId, geofenceId, enterTime(sort: Desc)])
}

enum CommandStatus {
  QUEUED
  SENT
  ACKED
  FAILED
  EXPIRED
}

/// A command sent (or queued) to a tracker, e.g. engine cut-off. Payload is the protocol text actually sent.
model DeviceCommand {
  id          String        @id @default(uuid()) @db.Uuid
  companyId   String        @db.Uuid
  objectId    String        @db.Uuid
  deviceId    String        @db.Uuid
  uniqueId    String
  type        String
  payload     String
  status      CommandStatus @default(QUEUED)
  response    String?
  error       String?
  createdById String?       @db.Uuid
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  sentAt      DateTime?     @db.Timestamptz(3)
  ackAt       DateTime?     @db.Timestamptz(3)
  expiresAt   DateTime      @db.Timestamptz(3)
  object      TrackedObject @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@index([objectId, createdAt(sort: Desc)])
  @@index([companyId, createdAt(sort: Desc)])
}

/// Customer API key. Only the SHA-256 of the key is stored; `prefix` (first characters) identifies it in the UI.
model ApiKey {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String    @db.Uuid
  /// Limits the key to one branch's vehicles (null = whole company).
  branchId      String?   @db.Uuid
  name          String
  prefix        String
  keyHash       String    @unique
  scopes        String[]
  ipAllowList   String[]  @default([])
  ratePerMinute Int       @default(60)
  ratePerDay    Int       @default(10000)
  expiresAt     DateTime? @db.Timestamptz(3)
  lastUsedAt    DateTime? @db.Timestamptz(3)
  lastUsedIp    String?
  requestCount  Int       @default(0)
  revokedAt     DateTime? @db.Timestamptz(3)
  createdById   String?   @db.Uuid
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

/// Outgoing webhook endpoint of a company. `secret` signs every request (HMAC-SHA256), so it is kept readable.
model WebhookEndpoint {
  id                  String    @id @default(uuid()) @db.Uuid
  companyId           String    @db.Uuid
  name                String
  url                 String
  events              String[]
  secret              String
  isActive            Boolean   @default(true)
  consecutiveFailures Int       @default(0)
  disabledAt          DateTime? @db.Timestamptz(3)
  disabledReason      String?
  lastDeliveryAt      DateTime? @db.Timestamptz(3)
  lastStatusCode      Int?
  createdById         String?   @db.Uuid
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3)

  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([companyId])
}

/// One event sent to one endpoint (kept 30 days). status: PENDING | RETRYING | SUCCEEDED | FAILED.
/// `dedupeKey` (endpoint + event id) stops an event being queued twice; tests and redeliveries have none.
model WebhookDelivery {
  id             String    @id @default(uuid()) @db.Uuid
  companyId      String    @db.Uuid
  endpointId     String    @db.Uuid
  eventId        String
  event          String
  payload        Json
  dedupeKey      String?   @unique
  status         String    @default("PENDING")
  attempt        Int       @default(0)
  nextAttemptAt  DateTime? @db.Timestamptz(3)
  responseStatus Int?
  durationMs     Int?
  error          String?
  responseBody   String?
  deliveredAt    DateTime? @db.Timestamptz(3)
  isTest         Boolean   @default(false)
  redeliveryOf   String?   @db.Uuid
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt(sort: Desc)])
  @@index([createdAt])
}

// ───────────── Licences & billing ─────────────

enum LicenceType {
  USER
  GPS_DEVICE
  DASHCAM
  FUEL_SENSOR
  /// Phone running the VeeTrax Tracker app (device model protocol `mobile`).
  MOBILE_TRACKER
  /// Developer API (customer API keys / webhooks): one account-level seat per company, plan on the seat.
  API_ACCESS
}

/// Platform-wide licence pricing and invoicing (supplier) details; one row, id = "default". Edited by the Super Admin.
model PlatformBillingSettings {
  id               String   @id @default("default")
  /// GST-inclusive yearly price per licence type, in paise: { USER, GPS_DEVICE, DASHCAM, FUEL_SENSOR }.
  pricesPaise      Json     @default("{}")
  gstRatePct       Float    @default(18)
  graceDays        Int      @default(15)
  overrideDays     Int      @default(30)
  legalName        String   @default("")
  addressLines     String[] @default([])
  city             String   @default("")
  stateCode        String   @default("33")
  pin              String   @default("")
  gstin            String   @default("")
  pan              String   @default("")
  phone            String   @default("")
  email            String   @default("")
  website          String   @default("")
  accountsEmail    String   @default("")
  /// Logo file name under var/billing/ (PNG / JPG / SVG).
  logoFile         String?
  /// Uploaded UPI QR image (e.g. a GPay QR) shown on the Buy screen and in the welcome email.
  upiQrFile        String?
  sacCode          String   @default("998314")
  invoicePrefix    String   @default("VTX")
  /// Credit notes have their own gap-free series: VTX/CN/2026-27/0001.
  creditNotePrefix String   @default("VTX/CN")
  /// Stock (device / SIM / accessory) sales invoices and their credit notes: own series.
  stockInvoicePrefix    String @default("VTX/S")
  stockCreditNotePrefix String @default("VTX/SCN")
  /// Developer API plans: { BASIC | STANDARD | ENTERPRISE: { pricePaise, maxVehicles (null = unlimited), ratePerMinute,
  /// ratePerDay, maxWebhooks } }; missing keys fall back to DEFAULT_API_PLANS (shared).
  apiPlans         Json     @default("{}")
  bankName         String   @default("")
  bankAccountName  String   @default("")
  bankAccountNo    String   @default("")
  bankIfsc         String   @default("")
  bankBranch       String   @default("")
  upiId            String   @default("")
  terms            String   @default("")
  footerNote       String   @default("")
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)
}

/// Billing details of a customer company or a partner (reseller); required before the first purchase.
model BillingProfile {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String?  @unique @db.Uuid
  partnerId   String?  @unique @db.Uuid
  billingName String
  address     String
  city        String   @default("")
  stateCode   String
  pin         String   @default("")
  gstin       String?
  email       String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  partner Partner? @relation(fields: [partnerId], references: [id], onDelete: Cascade)
}

/// One licence seat: runs 12 months from activation. In a company pool (companyId) or a partner pool (companyId null,
/// partnerId set); a company seat with partnerId was allocated by that partner. A seat stays in the pool when its user /
/// device / fuel sensor is deleted (subject set null) and is reused for the next one. source: PURCHASE | MIGRATION |
/// OVERRIDE | ALLOCATION. notifiedState: last expiry reminder sent (D30, D15, D7, D1, D0).
model LicenceSeat {
  id            String      @id @default(uuid()) @db.Uuid
  type          LicenceType
  companyId     String?     @db.Uuid
  partnerId     String?     @db.Uuid
  source        String
  activatedAt   DateTime    @db.Timestamptz(3)
  expiresAt     DateTime    @db.Timestamptz(3)
  userId        String?     @unique @db.Uuid
  deviceId      String?     @unique @db.Uuid
  fuelObjectId  String?     @unique @db.Uuid
  assignedAt    DateTime?   @db.Timestamptz(3)
  note          String?
  notifiedState String?
  lastOrderId   String?     @db.Uuid
  /// API_ACCESS seats only: BASIC | STANDARD | ENTERPRISE (the subject of an API seat is its company).
  apiPlan       String?
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @db.Timestamptz(3)

  company    Company?    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  partner    Partner?    @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  device     Device?     @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  fuelConfig FuelConfig? @relation(fields: [fuelObjectId], references: [objectId], onDelete: SetNull)

  @@index([companyId, type, expiresAt])
  @@index([partnerId, type])
  @@index([expiresAt])
}

/// A purchase / renewal: paid online (Razorpay, status CREATED → PAID after a verified webhook or signature) or recorded
/// offline by a Super Admin / partner (CASH, UPI, BANK_TRANSFER, CHEQUE). `items` = the quote lines (with seat ids).
model LicenceOrder {
  id                String    @id @default(uuid()) @db.Uuid
  companyId         String?   @db.Uuid
  partnerId         String?   @db.Uuid
  status            String    @default("CREATED")
  mode              String
  items             Json
  amountPaise       Int
  razorpayOrderId   String?   @unique
  razorpayPaymentId String?   @unique
  paymentReference  String?
  paidAt            DateTime? @db.Timestamptz(3)
  failureReason     String?
  createdById       String?   @db.Uuid
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  company Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)
  partner Partner? @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  invoice Invoice?

  @@index([companyId, createdAt(sort: Desc)])
  @@index([partnerId, createdAt(sort: Desc)])
}

/// GST tax invoice for one paid order. Numbered consecutively per Indian financial year (InvoiceCounter, gap-free).
/// supplier / buyer / lines are snapshots so the invoice never changes when settings or profiles are edited.
model Invoice {
  id               String    @id @default(uuid()) @db.Uuid
  number           String    @unique
  fy               String
  seq              Int
  issuedAt         DateTime  @db.Timestamptz(3)
  orderId          String    @unique @db.Uuid
  companyId        String?   @db.Uuid
  partnerId        String?   @db.Uuid
  buyerName        String
  buyerGstin       String?
  buyerStateCode   String
  supplier         Json
  buyer            Json
  lines            Json
  taxKind          String
  gstRatePct       Float
  sacCode          String
  taxablePaise     Int
  cgstPaise        Int
  sgstPaise        Int
  utgstPaise       Int
  igstPaise        Int
  totalPaise       Int
  paymentMode      String
  paymentReference String?
  paidAt           DateTime  @db.Timestamptz(3)
  pdfFile          String?
  emailedAt        DateTime? @db.Timestamptz(3)
  emailError       String?
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)

  order       LicenceOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  company     Company?     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  partner     Partner?     @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  creditNotes CreditNote[]

  @@unique([fy, seq])
  @@index([issuedAt])
  @@index([companyId, issuedAt(sort: Desc)])
  @@index([partnerId, issuedAt(sort: Desc)])
}

/// Last invoice number used per financial year; incremented inside the invoice transaction (row lock → gap-free).
model InvoiceCounter {
  fy      String @id
  lastSeq Int
}

/// GST credit note against an invoice (full or partial; Super Admin only). Own gap-free series per financial year
/// (CreditNoteCounter). `snapshot` holds everything printed (CreditNoteSnapshot, incl. the credited invoice lines and the
/// original invoice's tax type). Credited seats are expired at issue unless keepSeatsActive (e.g. a price correction).
/// refundMode: CASH | UPI | BANK_TRANSFER | CHEQUE | RAZORPAY_REFUND_MANUAL | NONE.
model CreditNote {
  id              String    @id @default(uuid()) @db.Uuid
  number          String    @unique
  fy              String
  seq             Int
  issuedAt        DateTime  @db.Timestamptz(3)
  invoiceId       String    @db.Uuid
  companyId       String?   @db.Uuid
  partnerId       String?   @db.Uuid
  buyerName       String
  buyerGstin      String?
  buyerStateCode  String
  snapshot        Json
  reason          String
  taxKind         String
  gstRatePct      Float
  taxablePaise    Int
  cgstPaise       Int
  sgstPaise       Int
  utgstPaise      Int
  igstPaise       Int
  totalPaise      Int
  refundMode      String
  refundReference String?
  keepSeatsActive Boolean   @default(false)
  revokedSeatIds  String[]  @default([])
  pdfFile         String?
  emailedAt       DateTime? @db.Timestamptz(3)
  emailError      String?
  createdById     String?   @db.Uuid
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  company Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)
  partner Partner? @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  @@unique([fy, seq])
  @@index([invoiceId])
  @@index([issuedAt])
  @@index([companyId, issuedAt(sort: Desc)])
}

/// Last credit note number used per financial year (same row-lock approach as InvoiceCounter → gap-free).
model CreditNoteCounter {
  fy      String @id
  lastSeq Int
}

enum DriverEventStatus {
  NEW
  REVIEWED
  DISMISSED
  COACHED
}

enum DriverMediaKind {
  PHOTO
  VIDEO
}

enum DriverMediaSource {
  SNAPSHOT
  ATTACHMENT
}

/// Driver behaviour event (ADAS / DMS / crash alert) with its cabin / road photos; one per alert.
model DriverEvent {
  id           String            @id @default(uuid()) @db.Uuid
  companyId    String            @db.Uuid
  objectId     String            @db.Uuid
  deviceId     String?           @db.Uuid
  /// Driver assigned to the vehicle when the event happened (DriverAssignment), if any.
  driverId     String?           @db.Uuid
  alertId      String?           @unique @db.Uuid
  /// Alert type code (DRIVER_EVENT_TYPES).
  type         String
  level        Int?
  speedKph     Float?
  lat          Float?
  lng          Float?
  address      String?
  occurredAt   DateTime          @db.Timestamptz(3)
  status       DriverEventStatus @default(NEW)
  reviewedById String?           @db.Uuid
  reviewedAt   DateTime?         @db.Timestamptz(3)
  note         String?
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)

  object TrackedObject      @relation(fields: [objectId], references: [id], onDelete: Cascade)
  driver Driver?            @relation(fields: [driverId], references: [id], onDelete: SetNull)
  media  DriverEventMedia[]

  @@index([companyId, occurredAt(sort: Desc)])
  @@index([objectId, occurredAt(sort: Desc)])
  @@index([driverId, occurredAt(sort: Desc)])
  @@index([deviceId, occurredAt(sort: Desc)])
}

/// Photo / clip of a driver event, stored under var/driver-media/ (path relative to that directory).
model DriverEventMedia {
  id         String            @id @default(uuid()) @db.Uuid
  eventId    String            @db.Uuid
  companyId  String            @db.Uuid
  kind       DriverMediaKind
  source     DriverMediaSource
  channel    Int?
  filePath   String
  fileSize   Int
  mime       String
  capturedAt DateTime?         @db.Timestamptz(3)
  createdAt  DateTime          @default(now()) @db.Timestamptz(3)

  event DriverEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([companyId, createdAt])
}

enum RelayTargetType {
  RAW_TCP
  HTTP_JSON
}

enum RelayScope {
  ALL
  COMPANY
  DEVICES
  PROTOCOL
}

/// Data forwarding (Super Admin): copy device data to another server. RAW_TCP mirrors the device's original bytes
/// from the gateway (one upstream connection per device connection); HTTP_JSON posts batches of normalised
/// positions from the notifier. The API publishes the resolved rule set to Valkey (`vt:relay:rules`).
/// Data forwarding master switch (one row, id = "default"); off pauses every target without changing them.
/// Point quality analysis (History → All points): platform on/off switch (single row "default"), Super Admin only.
model PointQualitySettings {
  id           String   @id @default("default")
  enabled      Boolean  @default(true)
  /// Phase 3: trips, daily distance and the History track leave out points flagged OUTLIER by the analysis job.
  useInReports Boolean  @default(false)
  updatedById  String?  @db.Uuid
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
}

model RelaySettings {
  id          String   @id @default("default")
  enabled     Boolean  @default(true)
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
}

model RelayTarget {
  id             String          @id @default(uuid()) @db.Uuid
  name           String
  type           RelayTargetType
  enabled        Boolean         @default(true)
  /// RAW_TCP
  host           String?
  port           Int?
  /// Write upstream replies back to the device (only for protocols where VeeTrax sends no replies). Default off.
  passDownstream Boolean         @default(false)
  /// HTTP_JSON
  url            String?
  /// NONE | BEARER | BASIC
  authType       String          @default("NONE")
  /// Bearer token, or `user:password` for BASIC.
  authValue      String?
  /// HMAC secret for the X-VeeTrax-Signature header.
  secret         String
  includeAlerts  Boolean         @default(false)
  scope          RelayScope      @default(ALL)
  companyId      String?         @db.Uuid
  deviceIds      String[]        @db.Uuid
  protocol       String?
  /// Filters: skip history / re-uploaded records; skip positions without a valid GPS fix.
  liveOnly       Boolean         @default(false)
  validOnly      Boolean         @default(false)
  createdById    String?         @db.Uuid
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)
}

/// Activation code for a phone running the VeeTrax Tracker app (sent by SMS; admins can read it in Devices).
model MobileTrackerCode {
  id         String    @id @default(uuid()) @db.Uuid
  /// Null for a self-service activation (number not registered yet): the device is created on verify.
  deviceId   String?   @db.Uuid
  /// Self-service / family consent: the number, owner e-mail and name the code was asked for.
  mobile     String?
  email      String?
  name       String?
  /// FAMILY_ADD: OTP sent to a family member's phone, verified by the account owner (consent).
  purpose    String    @default("ACTIVATE")
  companyId  String?   @db.Uuid
  /// 6 digits, shown to admins while pending (short-lived, single use).
  code       String
  expiresAt  DateTime  @db.Timestamptz(3)
  attempts   Int       @default(0)
  consumedAt DateTime? @db.Timestamptz(3)
  smsSent    Boolean   @default(false)
  /// Number of e-mails the code was sent to (device admins + the device's activation e-mail).
  emailCount Int       @default(0)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  device Device? @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, createdAt(sort: Desc)])
  @@index([mobile, createdAt(sort: Desc)])
}

/// The phone currently tracking for a mobile-tracker device. Activating on another phone revokes the previous one.
/// Why a tracker phone stopped and started, as reported by the app (1.3.4+).
model TrackerEvent {
  id         String   @id @default(uuid()) @db.Uuid
  deviceId   String   @db.Uuid
  kind       String
  at         DateTime @db.Timestamptz(3)
  why        String
  receivedAt DateTime @default(now()) @db.Timestamptz(3)

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, at, kind])
}

model MobileTrackerSession {
  id            String    @id @default(uuid()) @db.Uuid
  deviceId      String    @db.Uuid
  tokenHash     String    @unique
  deviceName    String?
  appVersion    String?
  platform      String?
  /// HMAC of the phone's Android ID for this app (stable across reinstalls): restores the session after a reinstall.
  installIdHash String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  lastUsedAt    DateTime? @db.Timestamptz(3)
  revokedAt     DateTime? @db.Timestamptz(3)

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([installIdHash])
}

/// Email verification code for a personal (individual) account sign-up.
model SignupCode {
  id         String    @id @default(uuid()) @db.Uuid
  email      String
  codeHash   String
  expiresAt  DateTime  @db.Timestamptz(3)
  attempts   Int       @default(0)
  consumedAt DateTime? @db.Timestamptz(3)
  ip         String?
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  @@index([email, createdAt(sort: Desc)])
}

/// "I've paid by UPI" from a customer (UTR); licences activate when a Super Admin confirms it against the bank.
model UpiPaymentClaim {
  id           String    @id @default(uuid()) @db.Uuid
  ownerKind    String
  ownerId      String    @db.Uuid
  /// The purchase (PurchaseDto: items + renewSeatIds) as quoted when the customer paid.
  purchase     Json
  amountPaise  Int
  /// UPI (UTR given) or CASH (paid / to be collected; utr = receipt no. if any).
  method       String    @default("UPI")
  utr          String?
  /// Customer's note, e.g. when / where to collect cash.
  customerNote String?
  paidOn       String
  summary      String
  status       String    @default("PENDING")
  createdById  String?   @db.Uuid
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  decidedAt    DateTime? @db.Timestamptz(3)
  decidedById  String?   @db.Uuid
  note         String?

  @@index([status, createdAt(sort: Desc)])
  @@index([ownerId])
}

// ───────────── Device inventory (Phase B) ─────────────
// Side tables only. Inventory code never writes Device.companyId / Device.isActive / LicenceSeat: a customer
// assignment stays on the existing admin assign / transfer / claim flows; inventory records the movement.

/// Where stock physically is. ownerPartnerId null = platform (VeeTrax) location.
model StockLocation {
  id             String   @id @default(uuid()) @db.Uuid
  /// STOCK_LOCATION_KINDS (shared): WAREHOUSE | PARTNER | TECHNICIAN | IN_TRANSIT | SUPPLIER_RMA | SCRAP
  kind           String
  code           String
  name           String
  ownerPartnerId String?  @db.Uuid
  address        String?
  stateCode      String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  ownerPartner  Partner?        @relation(fields: [ownerPartnerId], references: [id], onDelete: Restrict)
  receipts      StockReceipt[]
  stock         DeviceStock[]
  sims          SimCard[]
  movementsFrom StockMovement[] @relation("StockMovementFrom")
  movementsTo   StockMovement[] @relation("StockMovementTo")
  salesStores   StockStore[]

  /// + partial unique index on (code) WHERE ownerPartnerId IS NULL (raw SQL in the migration).
  @@unique([ownerPartnerId, code])
  @@index([kind])
}

/// Hardware suppliers (platform-level; partner-level later).
model Supplier {
  id             String   @id @default(uuid()) @db.Uuid
  ownerPartnerId String?  @db.Uuid
  name           String
  gstin          String?
  stateCode      String?
  contact        Json     @default("{}")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  ownerPartner Partner?       @relation(fields: [ownerPartnerId], references: [id], onDelete: Restrict)
  receipts     StockReceipt[]
  salesSuppliers StockSupplier[]

  /// + partial unique index on (name) WHERE ownerPartnerId IS NULL (raw SQL in the migration).
  @@unique([ownerPartnerId, name])
}

/// A goods receipt (GRN): one supplier invoice / PO received into a location.
model StockReceipt {
  id                String    @id @default(uuid()) @db.Uuid
  supplierId        String?   @db.Uuid
  locationId        String    @db.Uuid
  supplierInvoiceNo String?
  supplierInvoiceAt DateTime? @db.Date
  receivedAt        DateTime  @db.Timestamptz(3)
  /// MANUAL | CSV_IMPORT
  source            String    @default("MANUAL")
  itemCount         Int       @default(0)
  note              String?
  createdById       String?   @db.Uuid
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)

  supplier  Supplier?       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  location  StockLocation   @relation(fields: [locationId], references: [id], onDelete: Restrict)
  stock     DeviceStock[]
  movements StockMovement[]
  salesDoc  StockDoc?

  @@index([supplierId, receivedAt(sort: Desc)])
  @@index([receivedAt(sort: Desc)])
}

/// 1:1 inventory facts of an existing Device (IMEI uniqueness stays Device.uniqueId). Absent row = legacy device
/// whose status is derived from the existing assignment (deriveDeviceStatus in shared).
model DeviceStock {
  deviceId        String    @id @db.Uuid
  /// INVENTORY_STATUSES (shared); ASSIGNED / ACTIVE must agree with the existing company / vehicle assignment.
  status          String
  locationId      String?   @db.Uuid
  holderPartnerId String?   @db.Uuid
  receiptId       String?   @db.Uuid
  serialNumber    String?   @unique
  unitCostPaise   Int?
  warrantyUntil   DateTime? @db.Date
  /// DEVICE_CONDITIONS (shared): NEW | REFURBISHED | USED
  condition       String?
  note            String?
  statusChangedAt DateTime  @default(now()) @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  device        Device         @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  location      StockLocation? @relation(fields: [locationId], references: [id], onDelete: Restrict)
  holderPartner Partner?       @relation(fields: [holderPartnerId], references: [id], onDelete: SetNull)
  receipt       StockReceipt?  @relation(fields: [receiptId], references: [id], onDelete: SetNull)

  @@index([status, locationId])
  @@index([holderPartnerId, status])
  @@index([receiptId])
}

/// Append-only ledger: one row per stock change, written in the same transaction. Never updated or deleted by
/// application code; device / company / object purge only nulls the link (itemRef keeps the IMEI).
model StockMovement {
  id                  String   @id @default(uuid()) @db.Uuid
  deviceId            String?  @db.Uuid
  /// IMEI snapshot.
  itemRef             String
  /// STOCK_MOVEMENT_KINDS (shared)
  kind                String
  fromStatus          String?
  toStatus            String
  fromLocationId      String?  @db.Uuid
  toLocationId        String?  @db.Uuid
  fromHolderPartnerId String?  @db.Uuid
  toHolderPartnerId   String?  @db.Uuid
  /// Existing assignment linked to the movement (read from Device / DeviceAssignment, never written by inventory).
  companyId           String?  @db.Uuid
  objectId            String?  @db.Uuid
  partnerId           String?  @db.Uuid
  receiptId           String?  @db.Uuid
  reason              String?
  /// Courier AWB, RMA no., invoice no., or the linked record (e.g. "DeviceAssignment:<id>").
  reference           String?
  note                String?
  /// Field-level changes for ADJUST movements.
  changes             Json?
  at                  DateTime @default(now()) @db.Timestamptz(3)
  createdById         String?  @db.Uuid
  createdAt           DateTime @default(now()) @db.Timestamptz(3)

  device       Device?        @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  fromLocation StockLocation? @relation("StockMovementFrom", fields: [fromLocationId], references: [id], onDelete: SetNull)
  toLocation   StockLocation? @relation("StockMovementTo", fields: [toLocationId], references: [id], onDelete: SetNull)
  company      Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  object       TrackedObject? @relation(fields: [objectId], references: [id], onDelete: SetNull)
  partner      Partner?       @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  receipt      StockReceipt?  @relation(fields: [receiptId], references: [id], onDelete: SetNull)

  @@index([deviceId, at(sort: Desc)])
  @@index([at(sort: Desc)])
  @@index([toLocationId, at(sort: Desc)])
  @@index([fromLocationId, at(sort: Desc)])
  @@index([companyId, at(sort: Desc)])
  @@index([kind, at(sort: Desc)])
}

// ───────────── SIM management (Phase C) ─────────────
// Side tables only. SIM code never writes Device rows (Device.iccid stays tracker-reported, Device.simNumber /
// simOperator stay tenant-editable) and has no link to licence seats or to the customer assignment.

/// Network operator / M2M aggregator.
model SimProvider {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @unique
  /// SIM_PROVIDER_KINDS (shared): MNO | M2M_AGGREGATOR | ESIM
  kind           String   @default("MNO")
  supportContact Json     @default("{}")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  plans SimPlan[]
  sims  SimCard[]
}

/// Data plan of a provider. costPaise = what VeeTrax pays; pricePaise = customer price if billed (QI-3 open).
model SimPlan {
  id             String   @id @default(uuid()) @db.Uuid
  providerId     String   @db.Uuid
  name           String
  dataMbPerMonth Int?
  smsPerMonth    Int?
  validityDays   Int
  costPaise      Int
  pricePaise     Int?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  provider SimProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)
  sims     SimCard[]

  @@unique([providerId, name])
}

/// A managed SIM card. ICCID is the identity (normalised digits, unique).
model SimCard {
  id              String    @id @default(uuid()) @db.Uuid
  iccid           String    @unique
  msisdn          String?   @unique
  imsi            String?
  providerId      String    @db.Uuid
  planId          String?   @db.Uuid
  /// SIM_STATUSES (shared): AVAILABLE | RESERVED | ACTIVE | SUSPENDED | EXPIRED | DEACTIVATED | DAMAGED
  status          String    @default("AVAILABLE")
  /// SIM_OWNERSHIPS (shared): PLATFORM | PARTNER | CUSTOMER (BYO = tracking only, QI-4)
  ownership       String    @default("PLATFORM")
  locationId      String?   @db.Uuid
  activatedAt     DateTime? @db.Timestamptz(3)
  renewalDueAt    DateTime? @db.Date
  statusChangedAt DateTime  @default(now()) @db.Timestamptz(3)
  note            String?
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  provider    SimProvider     @relation(fields: [providerId], references: [id], onDelete: Restrict)
  plan        SimPlan?        @relation(fields: [planId], references: [id], onDelete: SetNull)
  location    StockLocation?  @relation(fields: [locationId], references: [id], onDelete: SetNull)
  assignments SimAssignment[]
  events      SimEvent[]
  usage       SimUsage[]

  @@index([status, renewalDueAt])
  @@index([providerId])
}

/// SIM ↔ device history (mirrors DeviceAssignment). One open row per SIM and per device (partial unique indexes in
/// the migration). deviceId is SET NULL on device purge; deviceRef keeps the IMEI.
model SimAssignment {
  id          String    @id @default(uuid()) @db.Uuid
  simId       String    @db.Uuid
  deviceId    String?   @db.Uuid
  deviceRef   String
  fromTime    DateTime  @db.Timestamptz(3)
  toTime      DateTime? @db.Timestamptz(3)
  createdById String?   @db.Uuid

  sim    SimCard @relation(fields: [simId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([simId, fromTime(sort: Desc)])
  @@index([deviceId, fromTime(sort: Desc)])
}

/// Append-only SIM history (status, assignment, renewal, edits, usage entries). Never updated or deleted by
/// application code; iccidRef / deviceRef keep the identifiers if the SIM or device row is removed.
model SimEvent {
  id          String   @id @default(uuid()) @db.Uuid
  simId       String?  @db.Uuid
  iccidRef    String
  /// SIM_EVENT_KINDS (shared)
  kind        String
  fromStatus  String?
  toStatus    String?
  deviceId    String?  @db.Uuid
  deviceRef   String?
  reason      String?
  note        String?
  changes     Json?
  at          DateTime @default(now()) @db.Timestamptz(3)
  createdById String?  @db.Uuid

  sim    SimCard? @relation(fields: [simId], references: [id], onDelete: SetNull)
  device Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([simId, at(sort: Desc)])
  @@index([deviceId, at(sort: Desc)])
  @@index([at(sort: Desc)])
}

/// Manual usage / cost entry for a period (operator bill line). Corrections are new entries (append-only).
model SimUsage {
  id          String   @id @default(uuid()) @db.Uuid
  simId       String   @db.Uuid
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date
  dataMb      Int?
  smsCount    Int?
  costPaise   Int?
  note        String?
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  sim SimCard @relation(fields: [simId], references: [id], onDelete: Restrict)

  @@index([simId, periodStart(sort: Desc)])
}

// ───────────── Stock (inventory): purchase → receipt → sale → returns, by IMEI / SIM number or count ─────────────
// Partner (reseller) and company references are plain ids (checked in the service) so the existing models stay as
// they are. Every quantity change is a StockMove written when a document is saved; editing a document rewrites its
// moves, and a serial's status is the effect of its latest move.

/// Something the platform buys and sells: a tracker model, a SIM, an accessory.
model StockItem {
  id                 String   @id @default(uuid()) @db.Uuid
  name               String   @unique
  /// DEVICE | SIM | ACCESSORY
  kind               String
  /// Tracker model received devices are created with (DEVICE items).
  deviceModelId      String?  @db.Uuid
  sku                String?
  hsnCode            String   @default("")
  gstRatePct         Float    @default(18)
  unit               String   @default("pcs")
  /// Tracked one by one by IMEI / SIM number (devices, SIMs); accessories are counted.
  serialTracked      Boolean  @default(false)
  /// Default selling price, GST inclusive, in paise.
  salePricePaise     Int      @default(0)
  /// Default buying price, GST inclusive, in paise.
  purchasePricePaise Int      @default(0)
  /// Reorder level: "low stock" when the main store has this many or fewer.
  lowStockAt         Int?
  /// Usual quantity to order when it runs low (suggested on the inventory dashboard).
  reorderQty         Int?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  deviceModel DeviceModel?    @relation(fields: [deviceModelId], references: [id], onDelete: SetNull)
  prices      StockPrice[]
  lines       StockDocLine[]
  serials     StockSerial[]
}

/// Special selling price of an item for one reseller (partnerId) or one customer company (companyId).
model StockPrice {
  id         String   @id @default(uuid()) @db.Uuid
  itemId     String   @db.Uuid
  partnerId  String?  @db.Uuid
  companyId  String?  @db.Uuid
  pricePaise Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  item StockItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

model StockSupplier {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  gstin       String?
  stateCode   String   @default("")
  address     String   @default("")
  city        String   @default("")
  pin         String   @default("")
  contactName String   @default("")
  phone       String   @default("")
  email       String   @default("")
  notes       String   @default("")
  /// Days from order to delivery (expected arrival of a PO = PO date + this).
  leadTimeDays Int     @default(7)
  /// Days after the supplier's invoice date the bill is due (overdue after that).
  paymentTermsDays Int @default(30)
  isActive    Boolean  @default(true)
  /// The same supplier in Stock & movements (filled on first use; receipts are recorded there too).
  inventorySupplierId String? @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  docs              StockDoc[]
  payments          StockSupplierPayment[]
  inventorySupplier Supplier? @relation(fields: [inventorySupplierId], references: [id], onDelete: SetNull)
}

/// Stock & sales stores (main store, damaged shelf, one per reseller). Separate from the inventory module's StockLocation.
model StockStore {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  /// STORE | DAMAGED | PARTNER
  kind      String
  /// The reseller this store belongs to (PARTNER).
  partnerId String?  @unique @db.Uuid
  isActive  Boolean  @default(true)
  /// The same place in Stock & movements (filled on first use): trackers here are kept there at this location.
  inventoryLocationId String? @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventoryLocation StockLocation? @relation(fields: [inventoryLocationId], references: [id], onDelete: SetNull)
}

/// One stock document: PO, RECEIPT, PURCHASE_RETURN, ORDER, SALE, SALES_RETURN or ADJUSTMENT.
model StockDoc {
  id                         String    @id @default(uuid()) @db.Uuid
  kind                       String
  /// "PO/26-27/0001"; per kind and financial year.
  number                     String    @unique
  fy                         String
  seq                        Int
  /// DRAFT | OPEN | PARTIAL | DONE | CANCELLED (stock moves only for DONE / PARTIAL receipts and DONE others).
  status                     String
  /// YYYY-MM-DD (India).
  docDate                    String
  /// Owner: the reseller that raised it; null = the platform.
  partnerId                  String?   @db.Uuid
  supplierId                 String?   @db.Uuid
  /// PO raised by a reseller to the platform (supplierId null): it shows in the platform's orders.
  toPlatform                 Boolean   @default(false)
  /// SALE: CUSTOMER | PARTNER | OWN.
  saleTo                     String?
  customerCompanyId          String?   @db.Uuid
  /// Reseller a SALE / ORDER is for (stock moves into its store).
  customerPartnerId          String?   @db.Uuid
  customerName               String    @default("")
  customerPhone              String    @default("")
  customerEmail              String    @default("")
  customerGstin              String?
  customerStateCode          String    @default("")
  customerAddress            String    @default("")
  /// Store the goods leave from / arrive at.
  locationId                 String?   @db.Uuid
  /// The document this one follows: receipt → PO, sale → order, returns → receipt / sale.
  sourceId                   String?   @db.Uuid
  /// How the order came in: CALL | WHATSAPP | EMAIL | VISIT | PORTAL.
  channel                    String?
  supplierInvoiceNo          String    @default("")
  supplierInvoiceDate        String?
  supplierInvoiceAmountPaise Int?
  reason                     String    @default("")
  notes                      String    @default("")
  totalPaise                 Int       @default(0)
  createdById                String?   @db.Uuid
  updatedById                String?   @db.Uuid
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  /// RECEIPT with trackers: the matching receipt in Stock & movements.
  inventoryReceiptId         String?   @unique @db.Uuid

  supplier         StockSupplier? @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  inventoryReceipt StockReceipt?  @relation(fields: [inventoryReceiptId], references: [id], onDelete: SetNull)
  lines    StockDocLine[]
  supplierPayments StockSupplierPayment[]
  files    StockFile[]
  moves    StockMove[]

  @@index([kind, docDate(sort: Desc)])
  @@index([partnerId])
  @@index([sourceId])
}

model StockDocLine {
  id         String   @id @default(uuid()) @db.Uuid
  docId      String   @db.Uuid
  itemId     String   @db.Uuid
  qty        Int
  /// GST inclusive unit price, paise.
  ratePaise  Int      @default(0)
  gstRatePct Float    @default(18)
  /// IMEIs / SIM numbers on this line (serial-tracked items).
  serials    String[]
  /// RECEIPT / SALES_RETURN: OK | DAMAGED (damaged go to the damaged shelf).
  condition  String   @default("OK")
  note       String   @default("")
  sort       Int      @default(0)

  doc  StockDoc  @relation(fields: [docId], references: [id], onDelete: Cascade)
  item StockItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([docId])
}

/// One IMEI / SIM number and where it is now.
/// A payment made to a supplier against a goods received note (its supplier invoice). Several per bill (advance,
/// balance…). Money record: a GRN with payments can not be deleted.
model StockSupplierPayment {
  id          String   @id @default(uuid()) @db.Uuid
  docId       String   @db.Uuid
  supplierId  String   @db.Uuid
  /// YYYY-MM-DD (India).
  paidOn      String
  amountPaise Int
  /// UPI | BANK | CASH | CHEQUE | CARD
  mode        String
  /// UTR / cheque no. / transaction id.
  reference   String   @default("")
  note        String   @default("")
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())

  doc      StockDoc      @relation(fields: [docId], references: [id], onDelete: Restrict)
  supplier StockSupplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@index([docId])
  @@index([supplierId, paidOn])
}

model StockSerial {
  id                String   @id @default(uuid()) @db.Uuid
  itemId            String   @db.Uuid
  serial            String
  /// IN_STOCK | DAMAGED | SOLD | WITH_SUPPLIER | USED | SCRAPPED
  status            String
  locationId        String?  @db.Uuid
  customerCompanyId String?  @db.Uuid
  customerPartnerId String?  @db.Uuid
  lastDocId         String?  @db.Uuid
  updatedAt         DateTime @updatedAt

  item StockItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([itemId, serial])
  @@index([serial])
}

/// Stock ledger: + into / − out of a location, written when a document is saved (rewritten on edit).
model StockMove {
  id         String   @id @default(uuid()) @db.Uuid
  docId      String   @db.Uuid
  itemId     String   @db.Uuid
  locationId String?  @db.Uuid
  qty        Int
  serial     String?
  /// What it does to the serial: IN_STOCK | DAMAGED | SOLD | WITH_SUPPLIER | USED | SCRAPPED.
  effect     String
  at         DateTime @default(now()) @db.Timestamptz(3)

  doc StockDoc @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@index([itemId, locationId])
  @@index([serial])
  @@index([docId])
}

/// Files on a stock document (the supplier's invoice on a receipt, delivery proof…).
model StockFile {
  id           String   @id @default(uuid()) @db.Uuid
  docId        String   @db.Uuid
  fileName     String
  filePath     String
  fileType     String
  fileSize     Int
  uploadedById String?  @db.Uuid
  createdAt    DateTime @default(now())

  doc StockDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
}

/// Sales invoice (for a SALE) or credit note (for a SALES_RETURN), from the platform owner's details.
model StockInvoice {
  id               String    @id @default(uuid()) @db.Uuid
  /// INVOICE | CREDIT_NOTE
  kind             String
  number           String    @unique
  fy               String
  seq              Int
  issuedAt         DateTime  @default(now()) @db.Timestamptz(3)
  docId            String    @unique @db.Uuid
  /// Credit note: the invoice it reduces.
  invoiceId        String?   @db.Uuid
  supplier         Json
  buyer            Json
  lines            Json
  taxKind          String
  taxablePaise     Int
  cgstPaise        Int
  sgstPaise        Int
  utgstPaise       Int
  igstPaise        Int
  totalPaise       Int
  /// UNPAID | PART | PAID (invoices).
  paymentStatus    String    @default("UNPAID")
  paidPaise        Int       @default(0)
  paymentMode      String?
  paymentReference String?
  paidAt           DateTime? @db.Timestamptz(3)
  pdfFile          String?
  createdById      String?   @db.Uuid
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

/// Gap-free numbering per series ("PO:26-27", "INV:26-27"…), same row-lock approach as InvoiceCounter.
model StockCounter {
  key     String @id
  lastSeq Int
}

/// Messaging channels the platform offers (Platform Settings → Messaging, Super Admin): SMS, e-mail, Arattai and
/// WhatsApp switches, and the Arattai Business set-up. Customers only see switched-on channels in their alert settings
/// (WhatsApp stays hidden from customers for now). One row (id "default"). Arattai secrets are write-only.
model MessagingSettings {
  id                    String    @id @default("default")
  smsEnabled            Boolean   @default(true)
  emailEnabled          Boolean   @default(true)
  whatsappEnabled       Boolean   @default(false)
  arattaiEnabled        Boolean   @default(false)
  /// Arattai-CompanyId and Arattai-BusinessNumberId headers.
  arattaiCompanyId      String    @default("")
  arattaiBusinessNumberId String  @default("")
  /// Approved authentication template with {{otp}} and {{validity_minutes}}.
  arattaiOtpTemplateId  String    @default("")
  /// Approved transactional template for alerts with {{alert}}, {{vehicle}}, {{time}} and {{details}}.
  arattaiAlertTemplateId String   @default("")
  arattaiLanguage       String    @default("en")
  arattaiClientId       String    @default("")
  arattaiClientSecret   String    @default("")
  /// From the one-time "Connect Arattai" approval (access_type=offline).
  arattaiRefreshToken   String    @default("")
  /// Random value of a pending Connect, checked when Arattai redirects back.
  arattaiOauthState     String?
  arattaiConnectedAt    DateTime? @db.Timestamptz(3)
  arattaiLastSentAt     DateTime? @db.Timestamptz(3)
  arattaiLastError      String?
  updatedAt             DateTime  @updatedAt
}

// ───────────── Routes & planned trips (module RTE, docs/routes-trips/SPEC.md) ─────────────
// Not the automatic Trip / Stop of the summarizer: a planned trip follows a Route and holds a snapshot of it.

enum PlannedTripStatus {
  SCHEDULED
  STARTED
  IN_PROGRESS
  COMPLETED
  INCOMPLETE
  CANCELLED
}

enum PlannedStopStatus {
  PENDING
  ARRIVED
  DEPARTED
  SKIPPED
}

/// Reusable plan: ordered stops with planned times relative to the trip start, a road path and a deviation corridor.
model Route {
  id          String          @id @default(uuid()) @db.Uuid
  companyId   String          @db.Uuid
  branchId    String?         @db.Uuid
  name        String
  code        String?
  description String?
  /// Half-width (m) of the deviation corridor around `path`.
  corridorM   Int             @default(200)
  /// [[lng,lat], ...] along roads from the routing engine; null = straight lines between stops.
  path        Json?
  /// Of `path` (m).
  distanceM   Int?
  /// Routing-engine driving time (s, no waits).
  durationSec Int?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)
  stops       RouteStop[]
  schedules   RouteSchedule[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
}

model RouteStop {
  id         String  @id @default(uuid()) @db.Uuid
  routeId    String  @db.Uuid
  route      Route   @relation(fields: [routeId], references: [id], onDelete: Cascade)
  /// 0 = start, last = end.
  seq        Int
  name       String
  lat        Float
  lng        Float
  /// Arrival radius (m).
  radiusM    Int     @default(100)
  /// Planned arrival, minutes after the trip's planned start (start stop: 0).
  offsetMin  Int     @default(0)
  /// Planned dwell (min); planned departure = arrival + wait.
  waitMin    Int     @default(0)
  /// Optional: stop taken from a geofence / place.
  geofenceId String? @db.Uuid

  @@unique([routeId, seq])
}

/// Days of the week + local start time; generates planned trips (API generator, next 24 h).
model RouteSchedule {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @db.Uuid
  routeId   String    @db.Uuid
  route     Route     @relation(fields: [routeId], references: [id], onDelete: Cascade)
  /// 0 = Sunday … 6 = Saturday (company timezone).
  days      Int[]
  /// Local minutes after midnight.
  startMin  Int
  /// Default vehicle (required to generate).
  objectId  String?   @db.Uuid
  /// Default driver.
  driverId  String?   @db.Uuid
  validFrom DateTime? @db.Date
  validTo   DateTime? @db.Date
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  @@index([companyId, isActive])
}

/// Driver + vehicle + route + planned start; holds a snapshot of the route so editing the route never alters it.
model PlannedTrip {
  id             String             @id @default(uuid()) @db.Uuid
  companyId      String             @db.Uuid
  branchId       String?            @db.Uuid
  routeId        String             @db.Uuid
  scheduleId     String?            @db.Uuid
  objectId       String             @db.Uuid
  driverId       String?            @db.Uuid
  /// Snapshot.
  routeName      String
  /// Snapshot.
  corridorM      Int
  /// Snapshot [[lng,lat], ...].
  path           Json?
  plannedStart   DateTime           @db.Timestamptz(3)
  /// Last stop's planned arrival.
  plannedEnd     DateTime           @db.Timestamptz(3)
  status         PlannedTripStatus  @default(SCHEDULED)
  actualStart    DateTime?          @db.Timestamptz(3)
  actualEnd      DateTime?          @db.Timestamptz(3)
  /// AUTO | MANUAL | TIMEOUT
  closedBy       String?
  cancelReason   String?
  notes          String?
  /// Actual, start → end.
  distanceKm     Float?
  deviationCount Int                @default(0)
  maxDeviationM  Int?
  /// Live: next stop not yet arrived.
  nextStopSeq    Int?
  /// Live.
  etaNextStop    DateTime?          @db.Timestamptz(3)
  /// Live / final: latest known delay vs plan (s, + late, − early).
  delaySec       Int?
  createdById    String?            @db.Uuid
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(3)
  stops          PlannedTripStop[]
  events         PlannedTripEvent[]

  @@unique([scheduleId, plannedStart])
  @@index([companyId, plannedStart])
  @@index([objectId, status])
  @@index([routeId, plannedStart])
}

model PlannedTripStop {
  id               String            @id @default(uuid()) @db.Uuid
  tripId           String            @db.Uuid
  trip             PlannedTrip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  seq              Int
  name             String
  lat              Float
  lng              Float
  radiusM          Int
  plannedArrival   DateTime          @db.Timestamptz(3)
  plannedDeparture DateTime          @db.Timestamptz(3)
  actualArrival    DateTime?         @db.Timestamptz(3)
  actualDeparture  DateTime?         @db.Timestamptz(3)
  status           PlannedStopStatus @default(PENDING)
  /// actualArrival − plannedArrival (s).
  delaySec         Int?

  @@unique([tripId, seq])
}

/// Unscheduled stop or deviation episode recorded during a trip.
model PlannedTripEvent {
  id      String      @id @default(uuid()) @db.Uuid
  tripId  String      @db.Uuid
  trip    PlannedTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  /// UNSCHEDULED_STOP | DEVIATION
  kind    String
  startAt DateTime    @db.Timestamptz(3)
  endAt   DateTime?   @db.Timestamptz(3)
  lat     Float
  lng     Float
  /// DEVIATION: { maxM }, UNSCHEDULED_STOP: { durationSec }
  data    Json?

  @@index([tripId, startAt])
}


// ---------------------------------------------------------------------------------------------------------------------
// Employee transport (ETMS). Migration etms_accounts (E1a, docs/employee-transport/15 §3). Raw SQL in the migration
// (Prisma cannot express it): partial unique "TransportServiceAgreement_live_pair_key" and the CHECKs
// _parties_check, _validity_check, _version_check, _lists_check, _active_approved_check, _ended_check.

/// Agreement lifecycle (D1 / P1). PROPOSED = terms frozen while both sides approve.
enum TransportAgreementStatus {
  DRAFT
  PROPOSED
  ACTIVE
  SUSPENDED
  ENDED
}

/// Closed grant list (doc 10 §2.2 item 3).
enum TransportGrant {
  VIEW_BOOKINGS
  MANAGE_DISPATCH
  VIEW_PASSENGER_MINIMAL
  VIEW_PASSENGER_CONTACT
  MANAGE_SCHEDULES
  RECEIVE_INCIDENTS
  MANAGE_INCIDENTS
  VIEW_REPORTS
  OVERRIDE_SAFETY_WARN
}

enum TransportDataProfile {
  MINIMAL
  STANDARD
}

/// Provider ↔ corporate customer contract with closed grants (D1). Corporate-managed mode has no row
/// (provider = customer). No companyId column on purpose: the purge planner reaches it through both Restrict FKs, so
/// purging either party deletes the agreement (doc 15 §1.2, §3.1). One live (DRAFT / PROPOSED / ACTIVE / SUSPENDED)
/// agreement per pair: partial unique index in the migration. Actor columns have no FK (a user purge never touches it).
model TransportServiceAgreement {
  id                       String                   @id @default(uuid()) @db.Uuid
  providerCompanyId        String                   @db.Uuid
  customerCompanyId        String                   @db.Uuid
  status                   TransportAgreementStatus @default(DRAFT)
  validFrom                DateTime                 @db.Timestamptz(3)
  /// Open-ended when null.
  validTo                  DateTime?                @db.Timestamptz(3)
  grants                   TransportGrant[]         @default([])
  /// Customer site (Poi, OFFICE) ids; no FK, validated on write. Empty = every customer site.
  siteIds                  String[]                 @default([]) @db.Uuid
  dataProfile              TransportDataProfile     @default(MINIMAL)
  approvedByCustomerAt     DateTime?                @db.Timestamptz(3)
  approvedByCustomerUserId String?                  @db.Uuid
  approvedByProviderAt     DateTime?                @db.Timestamptz(3)
  approvedByProviderUserId String?                  @db.Uuid
  suspendedAt              DateTime?                @db.Timestamptz(3)
  endedAt                  DateTime?                @db.Timestamptz(3)
  /// Suspend / end reason.
  statusReason             String?
  /// Optimistic concurrency (expectedVersion).
  version                  Int                      @default(1)
  createdById              String?                  @db.Uuid
  createdAt                DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime                 @updatedAt @db.Timestamptz(3)

  provider Company @relation("TransportAgreementProvider", fields: [providerCompanyId], references: [id], onDelete: Restrict)
  customer Company @relation("TransportAgreementCustomer", fields: [customerCompanyId], references: [id], onDelete: Restrict)

  @@index([providerCompanyId, status])
  @@index([customerCompanyId, status])
}
