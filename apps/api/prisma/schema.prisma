generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  BUSINESS
  INDIVIDUAL
  /// Personal account with phones of other people (added with their OTP consent) or several own phones.
  FAMILY
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
}

enum DataScope {
  COMPANY
  ASSIGNED
}

enum ObjectType {
  VEHICLE
  PERSON
  ASSET
  PET
}

enum VehicleType {
  CAR
  BIKE
  TRUCK
  BUS
  SCHOOL_BUS
  VAN
  AUTO
  OTHER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGIN_FAILED
  LOGOUT
  PASSWORD_RESET
}

model Partner {
  id             String          @id @default(uuid()) @db.Uuid
  name           String
  slug           String          @unique
  createdAt      DateTime        @default(now())
  /// The reseller's own company account: its admins (with billing permission) manage the partner pool.
  homeCompanyId  String?         @unique @db.Uuid
  /// Partner price overrides per licence type (paise, GST-inclusive); missing = platform price.
  pricesPaise    Json            @default("{}")
  updatedAt      DateTime        @updatedAt
  companies      Company[]
  billingProfile BillingProfile?
  licenceSeats   LicenceSeat[]
  licenceOrders  LicenceOrder[]
  invoices       Invoice[]
  creditNotes    CreditNote[]
}

model Company {
  id            String        @id @default(uuid()) @db.Uuid
  partnerId     String        @db.Uuid
  name          String
  accountType   AccountType   @default(BUSINESS)
  status        CompanyStatus @default(ACTIVE)
  timezone      String        @default("Asia/Kolkata")
  distanceUnit  String        @default("km")
  retentionDays Int           @default(90)
  settings      Json          @default("{}")
  isPlatform    Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  partner        Partner           @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  branches       Branch[]
  users          User[]
  roles          Role[]
  devices        Device[]
  objects        TrackedObject[]
  vehicleGroups  VehicleGroup[]
  drivers        Driver[]
  documents      Document[]
  pois           Poi[]
  lookups        Lookup[]
  auditLogs      AuditLog[]
  apiKeys        ApiKey[]
  webhooks       WebhookEndpoint[]
  billingProfile BillingProfile?
  licenceSeats   LicenceSeat[]
  licenceOrders  LicenceOrder[]
  invoices       Invoice[]
  creditNotes    CreditNote[]
}

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  name      String
  code      String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  objects TrackedObject[]
  users   UserBranch[]
  drivers Driver[]
  pois    Poi[]

  @@unique([companyId, name])
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  companyId        String    @db.Uuid
  name             String
  email            String?   @unique
  mobile           String?   @unique
  passwordHash     String?
  isSuperAdmin     Boolean   @default(false)
  managerId        String?   @db.Uuid
  isActive         Boolean   @default(true)
  preferences      Json      @default("{\"theme\":\"system\"}")
  lastLoginAt      DateTime?
  /// "Mark all alerts as read": alerts that occurred at or before this time count as read for this user.
  alertsReadBefore DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  manager        User?           @relation("UserManager", fields: [managerId], references: [id], onDelete: Restrict)
  reports        User[]          @relation("UserManager")
  roles          UserRole[]
  branches       UserBranch[]
  objects        UserObject[]
  sessions       Session[]
  passwordResets PasswordReset[]
  pushTokens     PushToken[]
  licenceSeat    LicenceSeat?

  @@index([companyId])
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @db.Uuid
  name        String
  description String?
  isSystem    Boolean   @default(false)
  dataScope   DataScope @default(ASSIGNED)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  permissions RolePermission[]
  users       UserRole[]

  @@unique([companyId, name])
}

model RolePermission {
  roleId  String   @db.Uuid
  menu    String
  actions String[]

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, menu])
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
}

model UserBranch {
  userId   String @db.Uuid
  branchId String @db.Uuid

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@id([userId, branchId])
  @@index([branchId])
}

model UserObject {
  userId   String @db.Uuid
  objectId String @db.Uuid

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  object TrackedObject @relation(fields: [objectId], references: [id], onDelete: Restrict)

  @@id([userId, objectId])
  @@index([objectId])
}

model DeviceModel {
  id                String   @id @default(uuid()) @db.Uuid
  brand             String
  model             String
  protocol          String
  capabilities      String[]
  fields            Json     @default("[]")
  commands          Json     @default("[]")
  timeOffsetMinutes Int      @default(0)
  filterDefaults    Json     @default("{}")
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  devices Device[]

  @@unique([brand, model])
}

model Device {
  id               String    @id @default(uuid()) @db.Uuid
  companyId        String?   @db.Uuid
  modelId          String    @db.Uuid
  uniqueId         String    @unique
  simNumber        String?
  simOperator      String?
  firmware         String?
  /// SIM ICCID reported by the tracker itself (Concox info packet, Teltonika IO 11/14, ICCID# / getimeiccid reply).
  iccid            String?
  /// Firmware version reported by the tracker (VERSION# / getver reply); `firmware` stays the admin's own note.
  firmwareReported String?
  deviceInfoAt     DateTime? @db.Timestamptz(3)
  ingestToken      String    @unique
  /// Shipped to a customer: code printed on the help sheet; the customer claims the device with IMEI + code.
  claimCode        String?   @unique
  /// Only this customer (email or +91 mobile) may claim it.
  reservedEmail    String?
  reservedMobile   String?
  reservedName     String?
  /// Courier / order note shown in Shipments (e.g. "DTDC D12345678 · order 1024").
  shipmentNote     String?
  shippedAt        DateTime? @db.Timestamptz(3)
  claimedAt        DateTime? @db.Timestamptz(3)
  /// Tracker app (mobile tracker model): extra address that gets the activation code (admins always get it).
  activationEmail  String?
  /// Tracker app: latest phone health report (permissions, battery / data restrictions, last stop) and when.
  trackerHealth    Json?
  trackerHealthAt  DateTime? @db.Timestamptz(3)
  isActive         Boolean   @default(true)
  lastSeenAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  company         Company?               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  model           DeviceModel            @relation(fields: [modelId], references: [id], onDelete: Restrict)
  assignments     DeviceAssignment[]
  licenceSeat     LicenceSeat?
  ioSensors       IoSensorConfig[]
  trackerCodes    MobileTrackerCode[]
  trackerSessions MobileTrackerSession[]

  @@index([companyId])
}

model TrackedObject {
  id               String       @id @default(uuid()) @db.Uuid
  companyId        String       @db.Uuid
  branchId         String?      @db.Uuid
  type             ObjectType   @default(VEHICLE)
  vehicleType      VehicleType?
  name             String
  plateNumber      String?
  make             String?
  model            String?
  color            String?
  icon             String?
  speedLimitKph    Int?
  odometerOffsetKm Float        @default(0)
  /// Set while the vehicle is in the workshop: alerts are suppressed and it is listed separately on the criticality board.
  maintenanceSince DateTime?    @db.Timestamptz(3)
  maintenanceNote  String?
  customFields     Json         @default("{}")
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  company         Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch          Branch?              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  assignments     DeviceAssignment[]
  groups          VehicleGroupMember[]
  users           UserObject[]
  remarks         ObjectRemark[]
  commands        DeviceCommand[]
  drivers         DriverAssignment[]
  documents       Document[]
  services        ServiceReminder[]
  serviceLog      ServiceRecord[]
  fuelConfig      FuelConfig?
  parkingSchedule ParkingSchedule?
  liveShares      LiveShare[]
  fuelEvents      FuelEvent[]
  ioSessions      IoSession[]
  driverEvents    DriverEvent[]

  @@index([companyId, branchId])
}

/// Support notes on a vehicle (e.g. "SIM recharged", "device removed for repair"), shown on the criticality board.
model ObjectRemark {
  id          String        @id @default(uuid()) @db.Uuid
  companyId   String        @db.Uuid
  objectId    String        @db.Uuid
  note        String
  createdById String?       @db.Uuid
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  object      TrackedObject @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@index([objectId, createdAt(sort: Desc)])
  @@index([companyId, createdAt(sort: Desc)])
}

/// At most one open (toTime null) row per device and per object: partial unique indexes in the init migration.
model DeviceAssignment {
  id       String    @id @default(uuid()) @db.Uuid
  deviceId String    @db.Uuid
  objectId String    @db.Uuid
  fromTime DateTime  @default(now())
  toTime   DateTime?

  device Device        @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  object TrackedObject @relation(fields: [objectId], references: [id], onDelete: Restrict)

  @@index([deviceId])
  @@index([objectId])
}

/// A person who drives company vehicles; identified on the tracker by an RFID card / iButton (`rfidTag`).
model Driver {
  id                   String    @id @default(uuid()) @db.Uuid
  companyId            String    @db.Uuid
  branchId             String?   @db.Uuid
  name                 String
  mobile               String?
  employeeId           String?
  licenseNo            String?
  licenseExpiry        DateTime? @db.Date
  /// Hex, upper case, without leading zeros (normalizeRfidTag); unique per company.
  rfidTag              String?
  notes                String?
  isActive             Boolean   @default(true)
  /// Last licence-expiry reminder raised (EXPIRING | EXPIRED) for licenseExpiry; reset when the expiry changes.
  licenseNotifiedState String?
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(3)

  company      Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch       Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  assignments  DriverAssignment[]
  documents    Document[]
  driverEvents DriverEvent[]

  @@unique([companyId, rfidTag])
  @@unique([companyId, employeeId])
  @@index([companyId, name])
}

/// Who drove which vehicle when. At most one open (toTime null) row per object and per driver (partial unique indexes in the migration).
model DriverAssignment {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @db.Uuid
  driverId    String    @db.Uuid
  objectId    String    @db.Uuid
  fromTime    DateTime  @db.Timestamptz(3)
  toTime      DateTime? @db.Timestamptz(3)
  /// MANUAL (assigned in the app) or RFID (card swipe on the tracker).
  source      String
  createdById String?   @db.Uuid

  driver Driver        @relation(fields: [driverId], references: [id], onDelete: Cascade)
  object TrackedObject @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@index([objectId, fromTime(sort: Desc)])
  @@index([driverId, fromTime(sort: Desc)])
  @@index([companyId, fromTime(sort: Desc)])
}

/// RC, insurance, PUC, licence… of a vehicle (objectId) or a driver (driverId); exactly one is set (CHECK in the migration).
model Document {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String    @db.Uuid
  objectId      String?   @db.Uuid
  driverId      String?   @db.Uuid
  /// DOCUMENT_TYPE lookup code.
  type          String
  number        String?
  issuedOn      DateTime? @db.Date
  expiresOn     DateTime? @db.Date
  reminderDays  Int       @default(30)
  notes         String?
  /// Attached scan / photo, stored under var/documents/.
  fileName      String?
  filePath      String?
  fileType      String?
  fileSize      Int?
  /// Last reminder alert raised (EXPIRING | EXPIRED); reset when the expiry changes. Makes the reminders job idempotent.
  notifiedState String?
  createdById   String?   @db.Uuid
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  company Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  object  TrackedObject? @relation(fields: [objectId], references: [id], onDelete: Cascade)
  driver  Driver?        @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([companyId, expiresOn])
  @@index([objectId])
  @@index([driverId])
}

/// Periodic maintenance of a vehicle by date and/or odometer; dueAt / dueOdometerKm = last service + interval.
model ServiceReminder {
  id                 String    @id @default(uuid()) @db.Uuid
  companyId          String    @db.Uuid
  objectId           String    @db.Uuid
  title              String
  intervalKm         Int?
  intervalDays       Int?
  lastDoneAt         DateTime? @db.Date
  lastDoneOdometerKm Float?
  dueAt              DateTime? @db.Date
  dueOdometerKm      Float?
  notifyBeforeKm     Int       @default(500)
  notifyBeforeDays   Int       @default(7)
  notes              String?
  isActive           Boolean   @default(true)
  /// Last reminder alert raised for the current due point (DUE_SOON | OVERDUE); reset when it rolls forward.
  notifiedState      String?
  createdById        String?   @db.Uuid
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)

  object  TrackedObject   @relation(fields: [objectId], references: [id], onDelete: Cascade)
  records ServiceRecord[]

  @@index([companyId])
  @@index([objectId])
}

/// One completed service (history), optionally of a reminder.
model ServiceRecord {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  objectId    String   @db.Uuid
  reminderId  String?  @db.Uuid
  title       String
  doneAt      DateTime @db.Date
  odometerKm  Float?
  cost        Float?
  notes       String?
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  object   TrackedObject    @relation(fields: [objectId], references: [id], onDelete: Cascade)
  reminder ServiceReminder? @relation(fields: [reminderId], references: [id], onDelete: SetNull)

  @@index([objectId, doneAt(sort: Desc)])
  @@index([reminderId])
  @@index([companyId, doneAt(sort: Desc)])
}

model VehicleGroup {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Higher wins when an object's groups have conflicting alert settings.
  alertPriority Int @default(0)

  company Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  members VehicleGroupMember[]

  @@unique([companyId, name])
}

model VehicleGroupMember {
  groupId  String @db.Uuid
  objectId String @db.Uuid

  group  VehicleGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  object TrackedObject @relation(fields: [objectId], references: [id], onDelete: Restrict)

  @@id([groupId, objectId])
  @@index([objectId])
}

/// System rows have companyId null; a partial unique index on (type, code) for them lives in the init migration.
model Lookup {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String?  @db.Uuid
  type      String
  code      String
  label     String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, type, code])
  @@index([type])
}

/// No foreign keys: high-volume table, becomes a Timescale hypertable when the extension is available.
model Position {
  objectId   String?  @db.Uuid
  deviceId   String   @db.Uuid
  fixTime    DateTime @db.Timestamptz(3)
  serverTime DateTime @db.Timestamptz(3)
  lat        Float
  lng        Float
  speedKph   Float    @db.Real
  course     Int      @db.SmallInt
  altitude   Float?   @db.Real
  satellites Int?     @db.SmallInt
  valid      Boolean
  ignition   Boolean?
  flags      Int      @default(0)
  attributes Json     @default("{}")

  @@id([deviceId, fixTime])
  @@index([objectId, fixTime(sort: Desc)])
}

model RawPacket {
  id            BigInt   @id @default(autoincrement())
  uniqueId      String?
  protocol      String
  remoteAddress String?
  receivedAt    DateTime @db.Timestamptz(3)
  hex           String

  @@index([receivedAt])
  @@index([uniqueId, receivedAt(sort: Desc)])
}

model UnknownDevice {
  uniqueId      String   @id
  protocol      String
  remoteAddress String?
  firstSeenAt   DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  packetCount   Int      @default(0)
}

model AuditLog {
  id        String      @id @default(uuid()) @db.Uuid
  companyId String?     @db.Uuid
  userId    String?     @db.Uuid
  action    AuditAction
  entity    String
  entityId  String?
  changes   Json?
  ip        String?
  createdAt DateTime    @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId, createdAt(sort: Desc)])
  @@index([entity, entityId])
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @unique
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushTokens PushToken[]

  @@index([userId])
}

/// Mobile app push registration (Expo push token). Tied to the sign-in session: no pushes once it is revoked or expired.
model PushToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  sessionId  String?  @db.Uuid
  token      String   @unique
  platform   String
  deviceName String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OtpCode {
  id         String    @id @default(uuid()) @db.Uuid
  mobile     String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([mobile, createdAt(sort: Desc)])
}

model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ───────────────────────────── M2a: geofences, alerts, templates, history, reports ─────────────────────────────

enum GeofenceType {
  CIRCLE
  POLYGON
  RECTANGLE
}

enum GeofenceMode {
  NORMAL
  NO_GO
  KEEP_IN
}

enum AlertLevel {
  COMPANY
  BRANCH
  GROUP
  OBJECT
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertStatus {
  NEW
  ACKNOWLEDGED
  RESOLVED
}

enum NotifyChannel {
  INAPP
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

enum RecipientMode {
  DEFAULT
  ADD
  ONLY
  NONE
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
}

enum ReportFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum ReportPeriod {
  DAY
  WEEK
  MONTH
}

enum ReportFormat {
  XLSX
  PDF
  CSV
}

enum RunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

/// geometry: {type:'CIRCLE',center:{lat,lng},radiusM} | {type:'POLYGON'|'RECTANGLE',points:[{lat,lng}]}; bbox columns speed up candidate lookup.
model Geofence {
  id            String       @id @default(uuid()) @db.Uuid
  companyId     String       @db.Uuid
  branchId      String?      @db.Uuid
  name          String
  category      String       @default("OTHER")
  type          GeofenceType
  geometry      Json
  minLat        Float
  minLng        Float
  maxLat        Float
  maxLng        Float
  color         String       @default("#0f766e")
  address       String?
  description   String?
  mode          GeofenceMode @default(NORMAL)
  notifyEnter   Boolean      @default(true)
  notifyExit    Boolean      @default(true)
  maxStayMin    Int?
  speedLimitKph Int?
  timeWindows   Json         @default("[]")
  appliesToAll  Boolean      @default(true)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  targets GeofenceTarget[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
}

/// Fuel sensor settings of a vehicle. source: none | can_level_pct | can_level_l | lls | analog.
/// calibration: [[raw, litres], …] ascending (LLS units or analog mV); refillMinL null = max(10 L, 5 % of the tank).
model FuelConfig {
  objectId        String   @id @db.Uuid
  companyId       String   @db.Uuid
  source          String   @default("none")
  tankCapacityL   Float?
  calibration     Json     @default("[]")
  refillMinL      Float?
  drainMinL       Float    @default(8)
  drainWindowMin  Int      @default(10)
  smoothingWindow Int      @default(5)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  object      TrackedObject @relation(fields: [objectId], references: [id], onDelete: Cascade)
  licenceSeat LicenceSeat?

  @@index([companyId])
}

/// Refill or drain (possible theft) detected by the processor. type: REFILL | DRAIN.
model FuelEvent {
  id           String   @id @db.Uuid
  companyId    String   @db.Uuid
  objectId     String   @db.Uuid
  type         String
  startTime    DateTime @db.Timestamptz(3)
  endTime      DateTime @db.Timestamptz(3)
  litresBefore Float
  litresAfter  Float
  deltaL       Float
  lat          Float?
  lng          Float?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  object TrackedObject @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@unique([objectId, type, startTime])
  @@index([companyId, startTime(sort: Desc)])
}

/// AC / door sensor wired to a tracker (one row per device and kind; the wiring is on the device). kind: AC | DOOR; source: DIGITAL | ANALOG.
/// DIGITAL: `attribute` is a boolean (or 0/1) input, `invert` flips it. ANALOG: ON while minV ≤ value ≤ maxV (volts).
model IoSensorConfig {
  deviceId    String   @db.Uuid
  kind        String
  companyId   String?  @db.Uuid
  enabled     Boolean  @default(true)
  source      String   @default("ANALOG")
  attribute   String   @default("adc1")
  invert      Boolean  @default(false)
  minV        Float?
  maxV        Float?
  hysteresisV Float    @default(0.2)
  debounceSec Int      @default(10)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@id([deviceId, kind])
  @@index([companyId])
}

/// One period in one AC / door state, written by the processor (endTime null = still in that state).
model IoSession {
  id           String    @id @db.Uuid
  companyId    String    @db.Uuid
  objectId     String    @db.Uuid
  kind         String
  on           Boolean
  startTime    DateTime  @db.Timestamptz(3)
  endTime      DateTime? @db.Timestamptz(3)
  startLat     Float?
  startLng     Float?
  endLat       Float?
  endLng       Float?
  distanceKm   Float     @default(0)
  durationSec  Int       @default(0)
  /// Seconds of this period with the ignition off (AC running with the engine off).
  engineOffSec Int       @default(0)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @default(now()) @db.Timestamptz(3)

  object TrackedObject @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@index([companyId, startTime(sort: Desc)])
  @@index([objectId, kind, startTime])
}

/// Point of interest (customer site, depot, fuel station…): a stop within radiusM counts as a visit.
model Poi {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  branchId    String?  @db.Uuid
  name        String
  category    String   @default("OTHER")
  lat         Float
  lng         Float
  address     String?
  radiusM     Int      @default(100)
  icon        String?
  color       String   @default("#2563eb")
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch  Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([companyId, isActive])
  @@index([companyId, lat, lng])
}

/// kind: BRANCH | GROUP | OBJECT (used when appliesToAll = false).
model GeofenceTarget {
  geofenceId String @db.Uuid
  kind       String
  refId      String @db.Uuid

  geofence Geofence @relation(fields: [geofenceId], references: [id], onDelete: Cascade)

  @@id([geofenceId, kind, refId])
  @@index([refId])
}

/// One override row per (level, target, alert type). targetId = companyId for COMPANY level. Null fields inherit.
model AlertSetting {
  id          String         @id @default(uuid()) @db.Uuid
  companyId   String         @db.Uuid
  level       AlertLevel
  targetId    String         @db.Uuid
  alertType   String
  enabled     Boolean?
  params      Json           @default("{}")
  schedule    Json?
  cooldownMin Int?
  severity    AlertSeverity?
  channels    Json?
  /// Require acknowledgement for this alert type; null = inherit (default: shared `defaultRequireAck`).
  requireAck  Boolean?
  updatedById String?        @db.Uuid
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([companyId, level, targetId, alertType])
  @@index([companyId])
}

/// alertType '*' and severity '*' = applies to all. entries: RecipientEntry[].
model RecipientList {
  id        String        @id @default(uuid()) @db.Uuid
  companyId String        @db.Uuid
  level     AlertLevel
  targetId  String        @db.Uuid
  alertType String        @default("*")
  severity  String        @default("*")
  channel   NotifyChannel
  mode      RecipientMode @default(DEFAULT)
  entries   Json          @default("[]")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([companyId, level, targetId, alertType, channel, severity])
  @@index([companyId])
}

model AlertSnooze {
  id          String     @id @default(uuid()) @db.Uuid
  companyId   String     @db.Uuid
  level       AlertLevel
  targetId    String     @db.Uuid
  alertTypes  String[]
  until       DateTime
  reason      String?
  createdById String?    @db.Uuid
  createdAt   DateTime   @default(now())

  @@index([companyId, until])
}

/// companyId null = system pack. settings: array of AlertSetting-like objects without level/target.
model AlertPack {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String?  @db.Uuid
  name        String
  description String?
  settings    Json     @default("[]")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, name])
}

/// High volume: no foreign keys.
model Alert {
  id          String        @id @default(uuid()) @db.Uuid
  companyId   String        @db.Uuid
  objectId    String        @db.Uuid
  deviceId    String?       @db.Uuid
  type        String
  severity    AlertSeverity
  message     String
  lat         Float?
  lng         Float?
  address     String?
  geofenceId  String?       @db.Uuid
  data        Json          @default("{}")
  occurredAt  DateTime      @db.Timestamptz(3)
  createdAt   DateTime      @default(now())
  status      AlertStatus   @default(NEW)
  ackById     String?       @db.Uuid
  ackAt       DateTime?
  ackNote     String?
  /// Needs acknowledgement: resolved from Alert Settings when the alert is raised (later setting changes don't rewrite it).
  ackRequired Boolean       @default(false)

  @@index([companyId, occurredAt(sort: Desc)])
  @@index([objectId, occurredAt(sort: Desc)])
  /// Unread count / NEW filters: company + status + recent first.
  @@index([companyId, status, occurredAt(sort: Desc)])
}

/// Per-user "read" mark for one alert (opening it). No foreign keys: Alert is high-volume and has none;
/// retention removes reads together with their alerts. Acknowledged alerts count as read for everyone.
model AlertRead {
  alertId String   @db.Uuid
  userId  String   @db.Uuid
  readAt  DateTime @default(now()) @db.Timestamptz(3)

  @@id([alertId, userId])
  @@index([userId, readAt])
}

model NotificationLog {
  id         String             @id @default(uuid()) @db.Uuid
  companyId  String             @db.Uuid
  alertId    String?            @db.Uuid
  channel    NotifyChannel
  recipient  String
  templateId String?            @db.Uuid
  subject    String?
  body       String
  status     NotificationStatus
  error      String?
  provider   String?
  createdAt  DateTime           @default(now())
  sentAt     DateTime?

  @@index([alertId])
  @@index([companyId, createdAt(sort: Desc)])
}

/// companyId null = system template (partial unique index in migration). approvalStatus: NA|DRAFT|PENDING|APPROVED|REJECTED.
model MessageTemplate {
  id             String        @id @default(uuid()) @db.Uuid
  companyId      String?       @db.Uuid
  purpose        String
  channel        NotifyChannel
  language       String        @default("en")
  name           String
  subject        String?
  body           String
  dltTemplateId  String?
  senderId       String?
  approvalStatus String        @default("NA")
  isActive       Boolean       @default(true)
  version        Int           @default(1)
  updatedById    String?       @db.Uuid
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  versions MessageTemplateVersion[]

  @@unique([companyId, purpose, channel, language])
  @@index([purpose, channel])
}

model MessageTemplateVersion {
  id          String   @id @default(uuid()) @db.Uuid
  templateId  String   @db.Uuid
  version     Int
  subject     String?
  body        String
  changedById String?  @db.Uuid
  createdAt   DateTime @default(now())

  template MessageTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, version])
}

model Trip {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @db.Uuid
  objectId     String   @db.Uuid
  startTime    DateTime @db.Timestamptz(3)
  endTime      DateTime @db.Timestamptz(3)
  startLat     Float
  startLng     Float
  endLat       Float
  endLng       Float
  startAddress String?
  endAddress   String?
  distanceKm   Float
  durationSec  Int
  idleSec      Int      @default(0)
  maxSpeedKph  Float
  avgSpeedKph  Float
  createdAt    DateTime @default(now())

  @@unique([objectId, startTime])
  @@index([companyId, startTime(sort: Desc)])
}

model Stop {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  objectId    String   @db.Uuid
  startTime   DateTime @db.Timestamptz(3)
  endTime     DateTime @db.Timestamptz(3)
  lat         Float
  lng         Float
  address     String?
  durationSec Int
  ignitionOn  Boolean
  createdAt   DateTime @default(now())

  @@unique([objectId, startTime])
  @@index([companyId, startTime(sort: Desc)])
}

/// Parking mode: weekly windows (company time zone) when the vehicle is armed; see packages/shared/src/parking.ts.
model ParkingSchedule {
  objectId       String   @id @db.Uuid
  companyId      String   @db.Uuid
  enabled        Boolean  @default(true)
  /// [{ days: number[] (0 = Sunday), startMin, endMin }]
  windows        Json     @default("[]")
  /// Every alert of the vehicle rings as an alarm while armed (else only the parking breach).
  alarmAllAlerts Boolean  @default(true)
  /// Reserved for SMS / IVR escalation when nobody acknowledges.
  escalation     Json     @default("{}")
  updatedById    String?  @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  object TrackedObject @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

/// Live location share link (public page /share/<token>), valid until expiresAt; the token is stored as a SHA-256 hash.
model LiveShare {
  id           String    @id @default(uuid()) @db.Uuid
  tokenHash    String    @unique
  companyId    String    @db.Uuid
  objectId     String    @db.Uuid
  createdById  String?   @db.Uuid
  note         String?
  hours        Int
  expiresAt    DateTime  @db.Timestamptz(3)
  revokedAt    DateTime? @db.Timestamptz(3)
  viewCount    Int       @default(0)
  lastViewedAt DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  object TrackedObject @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@index([objectId, createdAt(sort: Desc)])
  @@index([companyId])
}

/// Per object per local day (company timezone).
model DailySummary {
  objectId       String    @db.Uuid
  day            DateTime  @db.Date
  companyId      String    @db.Uuid
  distanceKm     Float     @default(0)
  runningSec     Int       @default(0)
  idleSec        Int       @default(0)
  stopSec        Int       @default(0)
  offlineSec     Int       @default(0)
  overspeedSec   Int       @default(0)
  overspeedCount Int       @default(0)
  tripCount      Int       @default(0)
  maxSpeedKph    Float     @default(0)
  avgSpeedKph    Float     @default(0)
  engineSec      Int       @default(0)
  firstStart     DateTime?
  lastStop       DateTime?
  updatedAt      DateTime  @updatedAt

  @@id([objectId, day])
  @@index([companyId, day])
}

/// Summarizer watermark per object; state holds the open trip/stop between runs.
model SummaryCursor {
  objectId       String   @id @db.Uuid
  processedUntil DateTime @db.Timestamptz(3)
  state          Json     @default("{}")
  updatedAt      DateTime @updatedAt
}

/// Days needing recomputation because late (out-of-order) positions arrived.
model SummaryDirtyDay {
  objectId  String   @db.Uuid
  day       DateTime @db.Date
  createdAt DateTime @default(now())

  @@id([objectId, day])
}

model ReportSchedule {
  id          String          @id @default(uuid()) @db.Uuid
  companyId   String          @db.Uuid
  ownerId     String          @db.Uuid
  name        String
  reportTypes String[]
  scope       Json            @default("{}")
  period      ReportPeriod    @default(DAY)
  frequency   ReportFrequency
  dayOfWeek   Int?
  dayOfMonth  Int?
  timeOfDay   String          @default("07:00")
  format      ReportFormat    @default(XLSX)
  recipients  String[]
  isActive    Boolean         @default(true)
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([companyId])
  @@index([isActive, nextRunAt])
}

model ReportRun {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String    @db.Uuid
  scheduleId    String?   @db.Uuid
  requestedById String?   @db.Uuid
  reportTypes   String[]
  params        Json      @default("{}")
  status        RunStatus @default(RUNNING)
  fileName      String?
  filePath      String?
  error         String?
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?

  @@index([scheduleId, startedAt(sort: Desc)])
  @@index([companyId, startedAt(sort: Desc)])
}

/// Reverse-geocoding cache keyed by coordinates rounded to 4 decimals (~11 m).
model AddressCache {
  key       String   @id
  address   String
  provider  String
  createdAt DateTime @default(now())
}

/// Written by the rules engine on every geofence entry/exit (independent of alert settings); read by reports.
model GeofenceVisit {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @db.Uuid
  objectId    String    @db.Uuid
  geofenceId  String    @db.Uuid
  enterTime   DateTime  @db.Timestamptz(3)
  exitTime    DateTime? @db.Timestamptz(3)
  durationSec Int?

  @@index([companyId, enterTime(sort: Desc)])
  @@index([objectId, geofenceId, enterTime(sort: Desc)])
}

enum CommandStatus {
  QUEUED
  SENT
  ACKED
  FAILED
  EXPIRED
}

/// A command sent (or queued) to a tracker, e.g. engine cut-off. Payload is the protocol text actually sent.
model DeviceCommand {
  id          String        @id @default(uuid()) @db.Uuid
  companyId   String        @db.Uuid
  objectId    String        @db.Uuid
  deviceId    String        @db.Uuid
  uniqueId    String
  type        String
  payload     String
  status      CommandStatus @default(QUEUED)
  response    String?
  error       String?
  createdById String?       @db.Uuid
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  sentAt      DateTime?     @db.Timestamptz(3)
  ackAt       DateTime?     @db.Timestamptz(3)
  expiresAt   DateTime      @db.Timestamptz(3)
  object      TrackedObject @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@index([objectId, createdAt(sort: Desc)])
  @@index([companyId, createdAt(sort: Desc)])
}

/// Customer API key. Only the SHA-256 of the key is stored; `prefix` (first characters) identifies it in the UI.
model ApiKey {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String    @db.Uuid
  /// Limits the key to one branch's vehicles (null = whole company).
  branchId      String?   @db.Uuid
  name          String
  prefix        String
  keyHash       String    @unique
  scopes        String[]
  ipAllowList   String[]  @default([])
  ratePerMinute Int       @default(60)
  ratePerDay    Int       @default(10000)
  expiresAt     DateTime? @db.Timestamptz(3)
  lastUsedAt    DateTime? @db.Timestamptz(3)
  lastUsedIp    String?
  requestCount  Int       @default(0)
  revokedAt     DateTime? @db.Timestamptz(3)
  createdById   String?   @db.Uuid
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

/// Outgoing webhook endpoint of a company. `secret` signs every request (HMAC-SHA256), so it is kept readable.
model WebhookEndpoint {
  id                  String    @id @default(uuid()) @db.Uuid
  companyId           String    @db.Uuid
  name                String
  url                 String
  events              String[]
  secret              String
  isActive            Boolean   @default(true)
  consecutiveFailures Int       @default(0)
  disabledAt          DateTime? @db.Timestamptz(3)
  disabledReason      String?
  lastDeliveryAt      DateTime? @db.Timestamptz(3)
  lastStatusCode      Int?
  createdById         String?   @db.Uuid
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3)

  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([companyId])
}

/// One event sent to one endpoint (kept 30 days). status: PENDING | RETRYING | SUCCEEDED | FAILED.
/// `dedupeKey` (endpoint + event id) stops an event being queued twice; tests and redeliveries have none.
model WebhookDelivery {
  id             String    @id @default(uuid()) @db.Uuid
  companyId      String    @db.Uuid
  endpointId     String    @db.Uuid
  eventId        String
  event          String
  payload        Json
  dedupeKey      String?   @unique
  status         String    @default("PENDING")
  attempt        Int       @default(0)
  nextAttemptAt  DateTime? @db.Timestamptz(3)
  responseStatus Int?
  durationMs     Int?
  error          String?
  responseBody   String?
  deliveredAt    DateTime? @db.Timestamptz(3)
  isTest         Boolean   @default(false)
  redeliveryOf   String?   @db.Uuid
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt(sort: Desc)])
  @@index([createdAt])
}

// ───────────── Licences & billing ─────────────

enum LicenceType {
  USER
  GPS_DEVICE
  DASHCAM
  FUEL_SENSOR
  /// Phone running the VeeTrax Tracker app (device model protocol `mobile`).
  MOBILE_TRACKER
  /// Developer API (customer API keys / webhooks): one account-level seat per company, plan on the seat.
  API_ACCESS
}

/// Platform-wide licence pricing and invoicing (supplier) details; one row, id = "default". Edited by the Super Admin.
model PlatformBillingSettings {
  id               String   @id @default("default")
  /// GST-inclusive yearly price per licence type, in paise: { USER, GPS_DEVICE, DASHCAM, FUEL_SENSOR }.
  pricesPaise      Json     @default("{}")
  gstRatePct       Float    @default(18)
  graceDays        Int      @default(15)
  overrideDays     Int      @default(30)
  legalName        String   @default("")
  addressLines     String[] @default([])
  city             String   @default("")
  stateCode        String   @default("33")
  pin              String   @default("")
  gstin            String   @default("")
  pan              String   @default("")
  phone            String   @default("")
  email            String   @default("")
  website          String   @default("")
  accountsEmail    String   @default("")
  /// Logo file name under var/billing/ (PNG / JPG / SVG).
  logoFile         String?
  /// Uploaded UPI QR image (e.g. a GPay QR) shown on the Buy screen and in the welcome email.
  upiQrFile        String?
  sacCode          String   @default("998314")
  invoicePrefix    String   @default("VTX")
  /// Credit notes have their own gap-free series: VTX/CN/2026-27/0001.
  creditNotePrefix String   @default("VTX/CN")
  /// Developer API plans: { BASIC | STANDARD | ENTERPRISE: { pricePaise, maxVehicles (null = unlimited), ratePerMinute,
  /// ratePerDay, maxWebhooks } }; missing keys fall back to DEFAULT_API_PLANS (shared).
  apiPlans         Json     @default("{}")
  bankName         String   @default("")
  bankAccountName  String   @default("")
  bankAccountNo    String   @default("")
  bankIfsc         String   @default("")
  bankBranch       String   @default("")
  upiId            String   @default("")
  terms            String   @default("")
  footerNote       String   @default("")
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)
}

/// Billing details of a customer company or a partner (reseller); required before the first purchase.
model BillingProfile {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String?  @unique @db.Uuid
  partnerId   String?  @unique @db.Uuid
  billingName String
  address     String
  city        String   @default("")
  stateCode   String
  pin         String   @default("")
  gstin       String?
  email       String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  partner Partner? @relation(fields: [partnerId], references: [id], onDelete: Cascade)
}

/// One licence seat: runs 12 months from activation. In a company pool (companyId) or a partner pool (companyId null,
/// partnerId set); a company seat with partnerId was allocated by that partner. A seat stays in the pool when its user /
/// device / fuel sensor is deleted (subject set null) and is reused for the next one. source: PURCHASE | MIGRATION |
/// OVERRIDE | ALLOCATION. notifiedState: last expiry reminder sent (D30, D15, D7, D1, D0).
model LicenceSeat {
  id            String      @id @default(uuid()) @db.Uuid
  type          LicenceType
  companyId     String?     @db.Uuid
  partnerId     String?     @db.Uuid
  source        String
  activatedAt   DateTime    @db.Timestamptz(3)
  expiresAt     DateTime    @db.Timestamptz(3)
  userId        String?     @unique @db.Uuid
  deviceId      String?     @unique @db.Uuid
  fuelObjectId  String?     @unique @db.Uuid
  assignedAt    DateTime?   @db.Timestamptz(3)
  note          String?
  notifiedState String?
  lastOrderId   String?     @db.Uuid
  /// API_ACCESS seats only: BASIC | STANDARD | ENTERPRISE (the subject of an API seat is its company).
  apiPlan       String?
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @db.Timestamptz(3)

  company    Company?    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  partner    Partner?    @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  device     Device?     @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  fuelConfig FuelConfig? @relation(fields: [fuelObjectId], references: [objectId], onDelete: SetNull)

  @@index([companyId, type, expiresAt])
  @@index([partnerId, type])
  @@index([expiresAt])
}

/// A purchase / renewal: paid online (Razorpay, status CREATED → PAID after a verified webhook or signature) or recorded
/// offline by a Super Admin / partner (CASH, UPI, BANK_TRANSFER, CHEQUE). `items` = the quote lines (with seat ids).
model LicenceOrder {
  id                String    @id @default(uuid()) @db.Uuid
  companyId         String?   @db.Uuid
  partnerId         String?   @db.Uuid
  status            String    @default("CREATED")
  mode              String
  items             Json
  amountPaise       Int
  razorpayOrderId   String?   @unique
  razorpayPaymentId String?   @unique
  paymentReference  String?
  paidAt            DateTime? @db.Timestamptz(3)
  failureReason     String?
  createdById       String?   @db.Uuid
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  company Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)
  partner Partner? @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  invoice Invoice?

  @@index([companyId, createdAt(sort: Desc)])
  @@index([partnerId, createdAt(sort: Desc)])
}

/// GST tax invoice for one paid order. Numbered consecutively per Indian financial year (InvoiceCounter, gap-free).
/// supplier / buyer / lines are snapshots so the invoice never changes when settings or profiles are edited.
model Invoice {
  id               String    @id @default(uuid()) @db.Uuid
  number           String    @unique
  fy               String
  seq              Int
  issuedAt         DateTime  @db.Timestamptz(3)
  orderId          String    @unique @db.Uuid
  companyId        String?   @db.Uuid
  partnerId        String?   @db.Uuid
  buyerName        String
  buyerGstin       String?
  buyerStateCode   String
  supplier         Json
  buyer            Json
  lines            Json
  taxKind          String
  gstRatePct       Float
  sacCode          String
  taxablePaise     Int
  cgstPaise        Int
  sgstPaise        Int
  utgstPaise       Int
  igstPaise        Int
  totalPaise       Int
  paymentMode      String
  paymentReference String?
  paidAt           DateTime  @db.Timestamptz(3)
  pdfFile          String?
  emailedAt        DateTime? @db.Timestamptz(3)
  emailError       String?
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)

  order       LicenceOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  company     Company?     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  partner     Partner?     @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  creditNotes CreditNote[]

  @@unique([fy, seq])
  @@index([issuedAt])
  @@index([companyId, issuedAt(sort: Desc)])
  @@index([partnerId, issuedAt(sort: Desc)])
}

/// Last invoice number used per financial year; incremented inside the invoice transaction (row lock → gap-free).
model InvoiceCounter {
  fy      String @id
  lastSeq Int
}

/// GST credit note against an invoice (full or partial; Super Admin only). Own gap-free series per financial year
/// (CreditNoteCounter). `snapshot` holds everything printed (CreditNoteSnapshot, incl. the credited invoice lines and the
/// original invoice's tax type). Credited seats are expired at issue unless keepSeatsActive (e.g. a price correction).
/// refundMode: CASH | UPI | BANK_TRANSFER | CHEQUE | RAZORPAY_REFUND_MANUAL | NONE.
model CreditNote {
  id              String    @id @default(uuid()) @db.Uuid
  number          String    @unique
  fy              String
  seq             Int
  issuedAt        DateTime  @db.Timestamptz(3)
  invoiceId       String    @db.Uuid
  companyId       String?   @db.Uuid
  partnerId       String?   @db.Uuid
  buyerName       String
  buyerGstin      String?
  buyerStateCode  String
  snapshot        Json
  reason          String
  taxKind         String
  gstRatePct      Float
  taxablePaise    Int
  cgstPaise       Int
  sgstPaise       Int
  utgstPaise      Int
  igstPaise       Int
  totalPaise      Int
  refundMode      String
  refundReference String?
  keepSeatsActive Boolean   @default(false)
  revokedSeatIds  String[]  @default([])
  pdfFile         String?
  emailedAt       DateTime? @db.Timestamptz(3)
  emailError      String?
  createdById     String?   @db.Uuid
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  company Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)
  partner Partner? @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  @@unique([fy, seq])
  @@index([invoiceId])
  @@index([issuedAt])
  @@index([companyId, issuedAt(sort: Desc)])
}

/// Last credit note number used per financial year (same row-lock approach as InvoiceCounter → gap-free).
model CreditNoteCounter {
  fy      String @id
  lastSeq Int
}

enum DriverEventStatus {
  NEW
  REVIEWED
  DISMISSED
  COACHED
}

enum DriverMediaKind {
  PHOTO
  VIDEO
}

enum DriverMediaSource {
  SNAPSHOT
  ATTACHMENT
}

/// Driver behaviour event (ADAS / DMS / crash alert) with its cabin / road photos; one per alert.
model DriverEvent {
  id           String            @id @default(uuid()) @db.Uuid
  companyId    String            @db.Uuid
  objectId     String            @db.Uuid
  deviceId     String?           @db.Uuid
  /// Driver assigned to the vehicle when the event happened (DriverAssignment), if any.
  driverId     String?           @db.Uuid
  alertId      String?           @unique @db.Uuid
  /// Alert type code (DRIVER_EVENT_TYPES).
  type         String
  level        Int?
  speedKph     Float?
  lat          Float?
  lng          Float?
  address      String?
  occurredAt   DateTime          @db.Timestamptz(3)
  status       DriverEventStatus @default(NEW)
  reviewedById String?           @db.Uuid
  reviewedAt   DateTime?         @db.Timestamptz(3)
  note         String?
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)

  object TrackedObject      @relation(fields: [objectId], references: [id], onDelete: Cascade)
  driver Driver?            @relation(fields: [driverId], references: [id], onDelete: SetNull)
  media  DriverEventMedia[]

  @@index([companyId, occurredAt(sort: Desc)])
  @@index([objectId, occurredAt(sort: Desc)])
  @@index([driverId, occurredAt(sort: Desc)])
  @@index([deviceId, occurredAt(sort: Desc)])
}

/// Photo / clip of a driver event, stored under var/driver-media/ (path relative to that directory).
model DriverEventMedia {
  id         String            @id @default(uuid()) @db.Uuid
  eventId    String            @db.Uuid
  companyId  String            @db.Uuid
  kind       DriverMediaKind
  source     DriverMediaSource
  channel    Int?
  filePath   String
  fileSize   Int
  mime       String
  capturedAt DateTime?         @db.Timestamptz(3)
  createdAt  DateTime          @default(now()) @db.Timestamptz(3)

  event DriverEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([companyId, createdAt])
}

enum RelayTargetType {
  RAW_TCP
  HTTP_JSON
}

enum RelayScope {
  ALL
  COMPANY
  DEVICES
  PROTOCOL
}

/// Data forwarding (Super Admin): copy device data to another server. RAW_TCP mirrors the device's original bytes
/// from the gateway (one upstream connection per device connection); HTTP_JSON posts batches of normalised
/// positions from the notifier. The API publishes the resolved rule set to Valkey (`vt:relay:rules`).
/// Data forwarding master switch (one row, id = "default"); off pauses every target without changing them.
/// Point quality analysis (History → All points): platform on/off switch (single row "default"), Super Admin only.
model PointQualitySettings {
  id           String   @id @default("default")
  enabled      Boolean  @default(true)
  /// Phase 3: trips, daily distance and the History track leave out points flagged OUTLIER by the analysis job.
  useInReports Boolean  @default(false)
  updatedById  String?  @db.Uuid
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
}

model RelaySettings {
  id          String   @id @default("default")
  enabled     Boolean  @default(true)
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
}

model RelayTarget {
  id             String          @id @default(uuid()) @db.Uuid
  name           String
  type           RelayTargetType
  enabled        Boolean         @default(true)
  /// RAW_TCP
  host           String?
  port           Int?
  /// Write upstream replies back to the device (only for protocols where VeeTrax sends no replies). Default off.
  passDownstream Boolean         @default(false)
  /// HTTP_JSON
  url            String?
  /// NONE | BEARER | BASIC
  authType       String          @default("NONE")
  /// Bearer token, or `user:password` for BASIC.
  authValue      String?
  /// HMAC secret for the X-VeeTrax-Signature header.
  secret         String
  includeAlerts  Boolean         @default(false)
  scope          RelayScope      @default(ALL)
  companyId      String?         @db.Uuid
  deviceIds      String[]        @db.Uuid
  protocol       String?
  /// Filters: skip history / re-uploaded records; skip positions without a valid GPS fix.
  liveOnly       Boolean         @default(false)
  validOnly      Boolean         @default(false)
  createdById    String?         @db.Uuid
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)
}

/// Activation code for a phone running the VeeTrax Tracker app (sent by SMS; admins can read it in Devices).
model MobileTrackerCode {
  id         String    @id @default(uuid()) @db.Uuid
  /// Null for a self-service activation (number not registered yet): the device is created on verify.
  deviceId   String?   @db.Uuid
  /// Self-service / family consent: the number, owner e-mail and name the code was asked for.
  mobile     String?
  email      String?
  name       String?
  /// FAMILY_ADD: OTP sent to a family member's phone, verified by the account owner (consent).
  purpose    String    @default("ACTIVATE")
  companyId  String?   @db.Uuid
  /// 6 digits, shown to admins while pending (short-lived, single use).
  code       String
  expiresAt  DateTime  @db.Timestamptz(3)
  attempts   Int       @default(0)
  consumedAt DateTime? @db.Timestamptz(3)
  smsSent    Boolean   @default(false)
  /// Number of e-mails the code was sent to (device admins + the device's activation e-mail).
  emailCount Int       @default(0)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  device Device? @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, createdAt(sort: Desc)])
  @@index([mobile, createdAt(sort: Desc)])
}

/// The phone currently tracking for a mobile-tracker device. Activating on another phone revokes the previous one.
model MobileTrackerSession {
  id            String    @id @default(uuid()) @db.Uuid
  deviceId      String    @db.Uuid
  tokenHash     String    @unique
  deviceName    String?
  appVersion    String?
  platform      String?
  /// HMAC of the phone's Android ID for this app (stable across reinstalls): restores the session after a reinstall.
  installIdHash String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  lastUsedAt    DateTime? @db.Timestamptz(3)
  revokedAt     DateTime? @db.Timestamptz(3)

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([installIdHash])
}

/// Email verification code for a personal (individual) account sign-up.
model SignupCode {
  id         String    @id @default(uuid()) @db.Uuid
  email      String
  codeHash   String
  expiresAt  DateTime  @db.Timestamptz(3)
  attempts   Int       @default(0)
  consumedAt DateTime? @db.Timestamptz(3)
  ip         String?
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  @@index([email, createdAt(sort: Desc)])
}

/// "I've paid by UPI" from a customer (UTR); licences activate when a Super Admin confirms it against the bank.
model UpiPaymentClaim {
  id           String    @id @default(uuid()) @db.Uuid
  ownerKind    String
  ownerId      String    @db.Uuid
  /// The purchase (PurchaseDto: items + renewSeatIds) as quoted when the customer paid.
  purchase     Json
  amountPaise  Int
  /// UPI (UTR given) or CASH (paid / to be collected; utr = receipt no. if any).
  method       String    @default("UPI")
  utr          String?
  /// Customer's note, e.g. when / where to collect cash.
  customerNote String?
  paidOn       String
  summary      String
  status       String    @default("PENDING")
  createdById  String?   @db.Uuid
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  decidedAt    DateTime? @db.Timestamptz(3)
  decidedById  String?   @db.Uuid
  note         String?

  @@index([status, createdAt(sort: Desc)])
  @@index([ownerId])
}
